.wrapper
  main.website-view
    h1 {{.Message}}
    p {{t $.L "billing-total"}} {{.Total}}
    if .Reference
      p {{t $.L "billing-reference"}} {{.Reference}}
    if .Payment
      p
        a(href="{{.Payment}}", rel="noopener noreferrer") {{t $.L "billing-method-link"}}
    if .PayPal
      p
        a(href="{{.PayPal}}", rel="noopener noreferrer") {{t $.L "billing-method-paypal"}}
    each method in .Instructions
      section
        h2 {{.Label}}
        if .Name
          p {{.Name}}
        pre {{.Details}}
    a(href="{{.Shop}}") {{t $.L "shop-continue"}}
