                        option(value="startAt") {{t $.L "r-df-start-at"}}
                        option(value="dueAt") {{t $.L "r-df-due-at"}}
                        option(value="endAt") {{t $.L "r-df-end-at"}}
                        option(value="receivedAt") {{t $.L "r-df-received-at"}}
                    .trigger-dropdown
                      input#reldate-days(type="number", value="0")
                    .trigger-dropdown
                      select#reldate-unit
                        option(value="minutes") {{t $.L "r-unit-minutes"}}
                        option(value="hours") {{t $.L "r-unit-hours"}}
                        option(value="days", selected) {{t $.L "r-unit-days"}}
                        option(value="weeks") {{t $.L "r-unit-weeks"}}
                        option(value="months") {{t $.L "r-unit-months"}}
                    .trigger-text {{t $.L "r-later"}}
                  button.trigger-button.js-set-reldate-action.js-goto-rules(type="button", aria-label="{{t $.L `r-add-action`}}")
                    i.fa.fa-plus(aria-hidden="true")
              //- WeKan's mailActions: an e-mail, To with addresses, people
                tokens and @members, and the rule's variables.
              .js-rules-tab.is-hidden(data-tab="mail-actions")
                .trigger-item.trigger-item-mail
                  .trigger-content.trigger-content-mail
                    .trigger-text.trigger-text-email {{t $.L "r-send-email"}}
                    .trigger-dropdown-mail
                      input#email-to(type="text", placeholder="{{t $.L `r-to`}}")
                    input#email-subject(type="text", placeholder="{{t $.L `r-subject`}}")
                    textarea#email-msg
                    label
                      input#email-card-details(type="checkbox")
                      | {{t $.L "details"}}
                    label
                      input#email-discussion(type="checkbox")
                      | {{t $.L "checklists"}} / {{t $.L "comments"}}
                    label
                      input#email-attachments(type="checkbox")
                      | {{t $.L "attachments"}}
                    .trigger-hint.trigger-hint-email-vars {{t $.L "r-email-vars-hint"}}
                    .trigger-hint.trigger-hint-people-vars {{t $.L "r-vars-people-hint"}}
                    .trigger-hint.trigger-hint-email-members {{t $.L "r-email-members-hint"}}
                  button.trigger-button.trigger-button-email.js-mail-action.js-goto-rules(type="button", aria-label="{{t $.L `r-add-action`}}")
                    i.fa.fa-plus(aria-hidden="true")
              .js-rules-tab.is-hidden(data-tab="checklist-actions")
                .trigger-item
                  .trigger-content
                    .trigger-dropdown
                      select#check-action
                        option(value="add") {{t $.L "r-add"}}
                        option(value="remove") {{t $.L "r-remove"}}
                    .trigger-text {{t $.L "r-checklist"}}
                    .trigger-dropdown
                      textarea#checklist-name(rows="2", placeholder="{{t $.L `r-name`}}")
                  button.trigger-button.js-add-checklist-action.js-goto-rules(type="button", aria-label="{{t $.L `r-add-action`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-dropdown
                      select#checkall-action
                        option(value="check") {{t $.L "r-check-all"}}
                        option(value="uncheck") {{t $.L "r-uncheck-all"}}
                    .trigger-text {{t $.L "r-items-check"}}
                    .trigger-dropdown
                      textarea#checklist-name2(rows="2", placeholder="{{t $.L `r-name`}}")
                  button.trigger-button.js-add-checkall-action.js-goto-rules(type="button", aria-label="{{t $.L `r-add-action`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-dropdown
                      select#check-item-action
                        option(value="check") {{t $.L "r-check"}}
                        option(value="uncheck") {{t $.L "r-uncheck"}}
                    .trigger-text {{t $.L "r-item"}}
                    .trigger-dropdown
                      textarea#checkitem-name(rows="2", placeholder="{{t $.L `r-name`}}")
                    .trigger-text {{t $.L "r-of-checklist"}}
                    .trigger-dropdown
                      textarea#checklist-name3(rows="2", placeholder="{{t $.L `r-name`}}")
                  button.trigger-button.js-add-check-item-action.js-goto-rules(type="button", aria-label="{{t $.L `r-add-action`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-add-checklist"}}
                    .trigger-dropdown
                      textarea#checklist-name-3(rows="2", placeholder="{{t $.L `r-name`}}")
                    .trigger-text {{t $.L "r-with-items"}}
                    .trigger-dropdown
                      textarea#checklist-items(rows="2", placeholder="{{t $.L `r-items-list`}}")
                  button.trigger-button.js-add-checklist-items-action.js-goto-rules(type="button", aria-label="{{t $.L `r-add-action`}}")
                    i.fa.fa-plus(aria-hidden="true")
        .rules-back
          button.primary.wide.js-goback(type="button", data-to="trigger")
            i.fa.fa-arrow-left
            |  {{t $.L "back"}}
    else
      p.quiet {{t $.L "r-rules-not-shown"}}
    if and $.CanEdit (eq $.View "blocks")
      script(src="/static/vendor/blockly.min.js")
      script(src="/static/weddy-blocks.js")
