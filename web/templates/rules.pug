//- WeKan's rulesMain, rulesList, rulesTriggers and rulesActions: the board's
  rules, and the wizard that makes one - its title, its trigger, its action.
.wrapper
  .rules-page(class="board-color-{{.Board.Color}}", data-board="{{.Board.ID}}", data-slug="{{.Board.Slug}}", data-view="{{.View}}")
    .board-header
      h1.header-board-name {{.Board.Title}} - {{t $.L "rules"}}
      a.board-header-btn.js-toggle-page-sidebar(href="#", title="{{t $.L `sidebar-open`}}", aria-label="{{t $.L `sidebar-open`}}") ☰
    //- The board's own sidebar, as the Rules page uses it in WeKan: Board
      Settings holds Rules and its views.
    .board-sidebar.sidebar
      a.sidebar-xmark.js-close-sidebar(href="#", aria-label="{{t $.L `close`}}") ✕
      .sidebar-content.js-board-sidebar-content
        h3
          a.board-header-btn.js-open-board-menu(href="#", title="{{t $.L `boardMenuPopup-title`}}") {{t $.L "boardMenuPopup-title"}}
    template.js-pop-over-template(data-pop="board-menu", data-title="{{t $.L `boardMenuPopup-title`}}")
      .header
        span.header-title {{t $.L "boardMenuPopup-title"}}
        a.close-btn.js-close-pop-over(href="#", aria-label="{{t $.L `close`}}") ×
      .content
        ul.pop-over-list
          if .CanEdit
            li
              a.js-open-rules-view(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules", title="{{t $.L `rules`}}")
                i.fa.fa-magic
                |  {{t $.L "rules"}}
            li
              a.js-open-rules-list-view(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules?view=list", title="{{t $.L `r-list-view`}}")
                i.fa.fa-list
                |  {{t $.L "r-list-view"}}
            li
              a.js-open-rules-workflow-view(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules?view=workflow", title="{{t $.L `r-workflow-view`}}")
                i.fa.fa-sitemap
                |  {{t $.L "r-workflow-view"}}
            li
              a.js-open-rules-blocks-view(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules?view=blocks", title="{{t $.L `r-blocks-view`}}")
                i.fa.fa-puzzle-piece
                |  {{t $.L "r-blocks-view"}}
            li
              a.js-open-rules-bots-view(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules?view=bots", title="{{t $.L `bots`}}")
                i.fa.fa-android
                |  {{t $.L "bots"}}
            li
              a.js-open-rules-import-export(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules?view=import", title="{{t $.L `rulesImportExportPopup-title`}}")
                i.fa.fa-exchange
                |  {{t $.L "rulesImportExportPopup-title"}}
    if .CanEdit
      //- WeKan's rulesImportExportPopup.
      template.js-pop-over-template(data-pop="rules-import-export", data-title="{{t $.L `rulesImportExportPopup-title`}}")
        .rules-import-export
          h3 {{t $.L "r-export"}}
          .rules-ie-btns
            a.button.primary.full.js-rules-export-json(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules/export?format=json", download="wekan-rules.json") {{t $.L "r-export-json"}}
            a.button.primary.full.js-rules-export-csv(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules/export?format=csv", download="wekan-rules.csv") {{t $.L "r-export-csv"}}
          hr
          h3 {{t $.L "r-import"}}
          p.rules-ie-hint {{t $.L "r-import-paste"}}
          textarea.rules-ie-textarea.js-rules-import-text(rows="8")
          .rules-ie-btns(data-done="{{t $.L `r-import-done`}}", data-unmapped="{{t $.L `r-import-unmapped`}}")
            button.primary.full.js-rules-import-json(type="button") {{t $.L "r-import-json"}}
            button.primary.full.js-rules-import-csv(type="button") {{t $.L "r-import-csv"}}
          hr
          //- WeKan's visual workflow import: n8n and Node-RED.
          h3 {{t $.L "r-import-workflow"}}
          p.rules-ie-hint {{t $.L "r-import-workflow-note"}}
          .rules-ie-btns
            select.js-workflow-format
              option(value="auto") {{t $.L "r-format-auto"}}
              option(value="n8n") n8n
              option(value="nodered") Node-RED
            button.primary.full.js-rules-import-workflow(type="button") {{t $.L "r-import-workflow"}}
          hr
          h3 {{t $.L "r-import-trello"}}
          p.rules-ie-hint {{t $.L "r-import-trello-note"}}
          .rules-ie-btns
            button.primary.full.js-rules-import-trello(type="button") {{t $.L "r-import-trello"}}
          hr
          h3 {{t $.L "r-wrike-workflow"}}
          p.rules-ie-hint {{t $.L "r-wrike-workflow-note"}}
          .rules-ie-btns
            a.button.primary.full.js-rules-export-wrike(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules/export?format=wrike", download="wrike-workflow.json") {{t $.L "r-export-wrike-workflow"}}
            button.primary.full.js-rules-import-wrike(type="button", data-done="{{t $.L `r-import-wrike-workflow-done`}}") {{t $.L "r-import-wrike-workflow"}}
          p.rules-ie-message.js-rules-import-message
    .rules-back-to-board
      a.js-rules-back-to-board(href="/b/{{.Board.ID}}/{{.Board.Slug}}", title="{{.Board.Title}}")
        i.fa.fa-arrow-left
        |  {{t $.L "back"}}
    if .CanEdit
      //- One step on the page at a time, as WeKan's rulesMain: each is a
        template, and the step shown is a copy of it.
      .js-rules-stage
      template.js-rules-pane(data-pane="list")
        .rules
          h2
            i.fa.fa-magic
            |  {{t $.L "r-board-rules"}}
          if .Rules
            .rules-toolbar
              button.primary.js-rules-select-all(type="button")
                i.fa.fa-check-square-o
                |  {{t $.L "r-select-all"}}
              button.primary.js-rules-select-none(type="button")
                i.fa.fa-square-o
                |  {{t $.L "r-unselect-all"}}
              button.primary.js-rules-delete-selected(type="button")
                i.fa.fa-trash
                |  {{t $.L "r-delete-selected"}}
          ul.rules-list
            each rule in .Rules
              li.rules-lists-item(data-rule-id="{{.ID}}")
                input.js-rule-select(type="checkbox", data-rule-id="{{.ID}}", aria-label="{{.Title}}")
                p {{.Title}}
                .rules-btns-group
                  button.primary.wide.js-goto-details(type="button", data-rule-id="{{.ID}}")
                    i.fa.fa-eye
                    |  {{t $.L "r-view-rule"}}
                  button.primary.wide.js-toggle-rule-enabled(type="button", data-rule-id="{{.ID}}", title="{{t $.L `r-toggle-rule-enabled`}}")
                    if .Enabled
                      i.fa.fa-toggle-on
                      |  {{t $.L "r-rule-enabled"}}
                    else
                      i.fa.fa-toggle-off
                      |  {{t $.L "r-rule-disabled"}}
                  //- #2713: WeKan's "Edit trigger/action" - the wizard, saving this rule.
                  button.primary.wide.js-edit-rule-full(type="button", data-rule-id="{{.ID}}", data-title="{{.Title}}")
                    i.fa.fa-sliders
                    |  {{t $.L "r-edit-rule-trigger-action"}}
                  button.primary.wide.js-delete-rule(type="button", data-rule-id="{{.ID}}")
                    i.fa.fa-trash
                    |  {{t $.L "r-delete-rule"}}
          .rules-add
            input#ruleTitle(type="text", placeholder="{{t $.L `r-add-rule`}}", aria-label="{{t $.L `r-add-rule`}}")
            button.primary.js-goto-trigger(type="button")
              i.fa.fa-plus
              |  {{t $.L "r-add-trigger"}}
      //- WeKan's rulesBlocks: a rule as a When block joined to a Then block, in
        Blockly; static/weddy-blocks.js builds the editor (rules_blocks_view.go).
      template.js-rules-pane(data-pane="blocks")
        .rules-blocks.js-rules-blocks(data-board="{{$.Board.ID}}", data-blocks="{{$.BlocksData}}")
          h2
            i.fa.fa-puzzle-piece
            |  {{t $.L "r-blocks-view"}}
          p {{t $.L "r-blocks-help"}}
          .rules-blocks-toolbar
            label
              | {{t $.L "r-rule"}}
              select.js-blocks-rule
                option(value="") {{t $.L "r-add-rule"}}
                each rule in $.BlockRules
                  option(value="{{.ID}}") {{.Title}}
            button.primary.js-blocks-new(type="button") {{t $.L "r-add-rule"}}
          label(for="blocks-rule-title") {{t $.L "r-new-rule-name"}}
          textarea#blocks-rule-title.js-blocks-title(rows="2")
          p.warning.js-blocks-error(role="alert", hidden)
          .js-rules-blocks-workspace.rules-blocks-workspace(aria-label="{{t $.L `r-blocks-view`}}")
          .rules-blocks-toolbar
            button.primary.js-blocks-save(type="button") {{t $.L "save"}}
            button.js-blocks-reload(type="button") {{t $.L "r-blocks-reload"}}
            span.js-blocks-dirty(hidden) {{t $.L "r-blocks-unsaved"}}
            span.js-blocks-saved(role="status", hidden) {{t $.L "r-blocks-saved"}}
      //- WeKan's rulesBots: the board's bots, its lists as columns with each
        card's run, and a card's thread in the drawer (rules_bots_view.go).
      template.js-rules-pane(data-pane="bots")
        .bots-view(data-board="{{$.Board.ID}}", data-slug="{{$.Board.Slug}}")
          aside.bots-rail
            section.bots-rail-section
              h3
                i.fa.fa-android
                |  {{t $.L "bots"}}
              ul.bots-list
                if $.Bots
                  each bot in $.Bots
                    li.bots-bot(class="{{if not .Enabled}}is-disabled{{end}}")
                      span.bots-bot-name {{.Title}}
                      span.quiet.bots-bot-host {{.Host}}
                      a.js-bots-remove(href="#", data-id="{{.ID}}", title="{{t $.L `delete`}}")
                        i.fa.fa-trash-o
                else
                  li.quiet {{t $.L "bots-none"}}
              form.bots-add.js-bots-add
                input.js-bots-title(type="text", required, placeholder="{{t $.L `bots-name`}}", aria-label="{{t $.L `bots-name`}}")
                input.js-bots-url(type="url", required, placeholder="{{t $.L `bots-url`}}", aria-label="{{t $.L `bots-url`}}")
                input.js-bots-token(type="password", autocomplete="off", placeholder="{{t $.L `bots-token`}}", aria-label="{{t $.L `bots-token`}}")
                button.primary(type="submit")
                  i.fa.fa-plus
                  |  {{t $.L "bots-add"}}
                p.warning.js-bots-add-error(role="alert", hidden)
            section.bots-rail-section
              h3
                i.fa.fa-bolt
                |  {{t $.L "bots-live"}}
              ul.bots-live
                if $.BotLive
                  each run in $.BotLive
                    li
                      a(href="/b/{{$.Board.ID}}/{{$.Board.Slug}}/rules?view=bots&card={{.CardID}}")
                        span.bots-pill(class="is-{{.Status}}") {{t $.L .StatusKey}}
                        |  {{.CardTitle}}
                      if .Ticker
                        .bots-ticker.quiet {{.Ticker}}
                else
                  li.quiet {{t $.L "bots-no-runs"}}
            section.bots-rail-section
              h3
                i.fa.fa-history
                |  {{t $.L "activity"}}
              ul.bots-activity
                each act in $.BotActivity
                  li.quiet
                    strong {{.BotTitle}}
                    | : {{.Text}}
          main.bots-board
            header.bots-header
              h2 {{$.Board.Title}} / {{t $.L "bots"}}
              span.quiet {{$.BotSummary}}
            .bots-columns
              each col in $.BotColumns
                section.bots-column.js-bots-drop(data-list-id="{{.ID}}")
                  header.bots-column-header
                    span.bots-column-title {{.Title}}
                    span.bots-counter {{len .Cards}}
                  each card in .Cards
                    article.bots-card.js-bots-card(draggable="true", data-card-id="{{.ID}}", data-swimlane-id="{{.SwimlaneID}}", data-sort="{{.Sort}}", class="{{if .Selected}}is-selected{{end}}")
                      .bots-card-top
                        if .TagName
                          span.card-label.bots-tag(class="card-label-{{.TagColor}}") {{.TagName}}
                        if .Number
                          span.quiet {{.Number}}
                        if .Run
                          span.bots-pill(class="is-{{.Run.Status}}") {{t $.L .Run.StatusKey}}
                      a.bots-card-title(href="/b/{{$.Board.ID}}/{{$.Board.Slug}}/rules?view=bots&card={{.ID}}") {{.Title}}
                      if .Run
                        if .Run.Ticker
                          .bots-ticker
                            i.fa.fa-terminal
                            |  {{.Run.Ticker}}
                        if .Run.Question
                          .bots-question
                            i.fa.fa-question-circle
                            |  {{.Run.Question}}
                          .bots-options
                            each opt in .Run.Options
                              button.js-bots-answer(type="button", data-run-id="{{index . `runId`}}", data-value="{{index . `value`}}") {{index . "label"}}
                      .bots-card-meta.quiet
                        span {{.Age}}
          if $.BotDrawer
            aside.bots-drawer
              header.bots-drawer-header
                h3 {{$.BotDrawer.Title}}
                a(href="/b/{{$.Board.ID}}/{{$.Board.Slug}}/rules?view=bots", title="{{t $.L `close`}}")
                  i.fa.fa-times
              .bots-dispatch
                if $.BotDrawer.Bots
                  select.js-bots-choose(aria-label="{{t $.L `bots`}}")
                    each bot in $.BotDrawer.Bots
                      option(value="{{.ID}}") {{.Title}}
                  button.primary.js-bots-dispatch(type="button", data-card-id="{{$.BotDrawer.ID}}")
                    i.fa.fa-play
                    |  {{t $.L "bots-dispatch"}}
                if $.BotDrawer.Run
                  if $.BotDrawer.Run.Active
                    button.js-bots-stop(type="button", data-run-id="{{$.BotDrawer.Run.ID}}")
                      i.fa.fa-stop
                      |  {{t $.L "bots-stop"}}
              if $.BotDrawer.Run
                p
                  span.bots-pill(class="is-{{$.BotDrawer.Run.Status}}") {{t $.L $.BotDrawer.Run.StatusKey}}
                  if $.BotDrawer.Run.CostText
                    span.quiet  {{$.BotDrawer.Run.CostText}}
              ul.bots-thread
                each item in $.BotDrawer.Thread
                  li.bots-thread-item(class="is-{{.Kind}}")
                    .bots-thread-meta.quiet
                      if .IsEvent
                        i.fa.fa-cog
                      else
                        i.fa.fa-comment-o
                      |  {{.Who}} · {{.When}}
                    .bots-thread-text {{.Text}}
              if $.BotDrawer.Run
                if $.BotDrawer.Run.Active
                  form.bots-reply.js-bots-reply(data-run-id="{{$.BotDrawer.Run.ID}}")
                    textarea.js-bots-reply-text(rows="3", placeholder="{{t $.L `bots-reply`}}", aria-label="{{t $.L `bots-reply`}}")
                    button.primary(type="submit") {{t $.L "bots-send"}}
      //- WeKan's rulesWorkflow: each rule as its trigger leading to its actions.
      template.js-rules-pane(data-pane="workflow")
        .rules-workflow
          h2
            i.fa.fa-sitemap
            |  {{t $.L "r-workflow-view"}}
          p.workflow-help {{t $.L "r-workflow-help"}}
          p.warning.js-workflow-error(role="alert", hidden)
          //- WeKan's builder: a trigger chip dropped into When, an action into Then.
          .workflow-builder
            .workflow-builder-row
              .workflow-slot.js-when-slot(data-empty="{{t $.L `r-when`}}: {{t $.L `r-drop-trigger`}}")
                span.workflow-slot-placeholder {{t $.L "r-when"}}: {{t $.L "r-drop-trigger"}}
              .workflow-arrow
                i.fa.fa-long-arrow-right
              .workflow-slot.js-then-slot(data-empty="{{t $.L `r-action`}}: {{t $.L `r-drop-action`}}")
                span.workflow-slot-placeholder {{t $.L "r-action"}}: {{t $.L "r-drop-action"}}
            .workflow-builder-controls
              textarea.js-workflow-rule-title(rows="2", placeholder="{{t $.L `r-new-rule-name`}}")
              button.primary.js-create-workflow-rule(type="button", disabled)
                i.fa.fa-plus
                |  {{t $.L "r-add-rule"}}
          .workflow-palettes
            .workflow-palette
              h3 {{t $.L "r-trigger"}}
              each chip in $.TriggerPalette
                .workflow-chip.js-trigger-chip(draggable="true", data-idx="{{.Idx}}", data-doc="{{.Doc}}", data-label="{{.Label}}")
                  i.fa.fa-bolt
                  span {{.Label}}
            .workflow-palette
              h3 {{t $.L "r-action"}}
              each chip in $.ActionPalette
                .workflow-chip.js-action-chip(draggable="true", data-idx="{{.Idx}}", data-doc="{{.Doc}}", data-label="{{.Label}}")
                  i.fa.fa-play
                  span {{.Label}}
          h3.workflow-existing-title {{t $.L "r-board-rules"}}
          each rule in .Rules
            .workflow-rule.js-rule-node(data-rule-id="{{.ID}}", data-trigger="{{.TriggerDoc}}")
              .workflow-rule-title {{.Title}}
              .workflow-node.workflow-trigger {{.Trigger}}
              each act in .Actions
                .workflow-node.workflow-action {{.}}
              a.workflow-rule-delete.js-delete-workflow-rule(href="#", title="{{t $.L `r-delete-rule`}}")
                i.fa.fa-trash
      each rule in .Rules
        //- WeKan's ruleDetails: what the rule waits for, and what it does.
        template.js-rules-pane(data-pane="details-{{.ID}}")
          .rules
            h2
              i.fa.fa-magic
              |  {{t $.L "r-rule-details"}}
            .triggers-content
              .triggers-body
                .triggers-main-body
                  h4 {{t $.L "r-trigger"}}
                  .trigger-item
                    .trigger-content
                      .trigger-text {{.Trigger}}
                  h4 {{t $.L "r-action"}}
                  each act in .Actions
                    .trigger-item
                      .trigger-content
                        .trigger-text {{.}}
            .rules-back
              button.primary.wide.js-goback(type="button", data-to="list")
                i.fa.fa-arrow-left
                |  {{t $.L "back"}}
      template.js-rules-pane(data-pane="trigger")
        h2
          i.fa.fa-magic
          |  {{t $.L "r-rule"}} "
          span.js-rule-name
          | " - {{t $.L "r-add-trigger"}}
        .triggers-content
          .triggers-body
            .triggers-side-menu
              ul
                li.active.js-set-board-triggers(data-tab="board")
                  i.fa.fa-bar-chart
                li.js-set-card-triggers(data-tab="card")
                  i.fa.fa-file-text-o
                li.js-set-checklist-triggers(data-tab="checklist")
                  i.fa.fa-check
                li.js-set-scheduled-triggers(data-tab="scheduled", title="{{t $.L `r-set-scheduled-triggers`}}")
                  i.fa.fa-clock-o
                li.js-set-button-triggers(data-tab="button", title="{{t $.L `r-set-button-triggers`}}")
                  i.fa.fa-hand-pointer-o
            .triggers-main-body
              p.rules-vars-hint.js-trigger-vars-hint {{t $.L "r-trigger-vars-hint"}}
              //- #3195: insert a rule variable into the text field last focused.
              label.rule-variable-picker
                span {{t $.L "r-insert-variable"}}
                select.js-rule-variable-picker
                  option(value="") -
                  each tok in $.RuleTokens
                    option(value="{{.}}") {{.}}
              .js-rules-tab(data-tab="board")
                .trigger-item#trigger-two
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-card"}}
                    .trigger-text {{copula $.L}}
                    .trigger-text {{t $.L "r-added-to"}}
                    .trigger-text {{t $.L "r-list"}}
                    .trigger-dropdown
                      textarea#create-list-name(rows="2", placeholder="{{t $.L `r-list-name`}}")
                    .trigger-text {{t $.L "r-in-swimlane"}}
                    .trigger-dropdown
                      textarea#create-swimlane-name(rows="2", placeholder="{{t $.L `r-swimlane-name`}}")
                  button.trigger-button.js-add-create-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item#trigger-three
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-card"}}
                    .trigger-text {{t $.L "r-is-moved"}}
                  button.trigger-button.js-add-gen-moved-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item#trigger-four
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-card"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#move-action
                        option(value="moved-to") {{t $.L "r-moved-to"}}
                        option(value="moved-from") {{t $.L "r-moved-from"}}
                    .trigger-text {{t $.L "r-list"}}
                    .trigger-dropdown
                      textarea#move-list-name(rows="2", placeholder="{{t $.L `r-list-name`}}")
                    .trigger-text {{t $.L "r-in-swimlane"}}
                    .trigger-dropdown
                      textarea#create-swimlane-name-2(rows="2", placeholder="{{t $.L `r-swimlane-name`}}")
                  button.trigger-button.js-add-moved-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                //- #2076: a card moved forward (to a later list) or back (to an
                  earlier one), in the board's list order.
                .trigger-item#trigger-move-direction
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-card"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#move-direction
                        option(value="forward") {{t $.L "r-moved-forward"}}
                        option(value="back") {{t $.L "r-moved-back"}}
                  button.trigger-button.js-add-move-direction-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item#trigger-five
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-card"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#arch-action
                        option(value="archived") {{t $.L "r-archived"}}
                        option(value="unarchived") {{t $.L "r-unarchived"}}
                        option(value="commented") {{t $.L "r-commented"}}
                  button.trigger-button.js-add-arch-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
              .js-rules-tab.is-hidden(data-tab="card")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-label-is"}}
                    .trigger-dropdown
                      select#label-action
                        option(value="added") {{t $.L "r-added-to"}}
                        option(value="removed") {{t $.L "r-removed-from"}}
                    .trigger-text {{t $.L "r-a-card"}}
                  button.trigger-button.js-add-gen-label-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    if not (nameBeforeSubject $.L)
                      .trigger-text {{t $.L "r-when-the-label"}}
                    .trigger-dropdown
                      select#spec-label
                        each lb in $.Labels
                          option(value="{{.ID}}") {{.Name}}
                    if nameBeforeSubject $.L
                      .trigger-text {{t $.L "r-when-the-label"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#spec-label-action
                        option(value="added") {{t $.L "r-added-to"}}
                        option(value="removed") {{t $.L "r-removed-from"}}
                    .trigger-text {{t $.L "r-a-card"}}
                  button.trigger-button.js-add-spec-label-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
