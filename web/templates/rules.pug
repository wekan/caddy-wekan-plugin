//- WeKan's rulesMain, rulesList, rulesTriggers and rulesActions: the board's
  rules, and the wizard that makes one - its title, its trigger, its action.
.wrapper
  .rules-page(class="board-color-{{.Board.Color}}", data-board="{{.Board.ID}}", data-slug="{{.Board.Slug}}", data-view="{{.View}}")
    .board-header
      h1.header-board-name {{.Board.Title}} - {{t $.L "rules"}}
      a.board-header-btn.js-toggle-page-sidebar(href="#", title="{{t $.L `sidebar-open`}}", aria-label="{{t $.L `sidebar-open`}}") ☰
    //- The board's own sidebar, as the Rules page uses it in WeKan: Board
      Settings holds Rules and its views.
    .board-sidebar.sidebar
      a.sidebar-xmark.js-close-sidebar(href="#", aria-label="{{t $.L `close`}}") ✕
      .sidebar-content.js-board-sidebar-content
        h3
          a.board-header-btn.js-open-board-menu(href="#", title="{{t $.L `boardMenuPopup-title`}}") {{t $.L "boardMenuPopup-title"}}
    template.js-pop-over-template(data-pop="board-menu", data-title="{{t $.L `boardMenuPopup-title`}}")
      .header
        span.header-title {{t $.L "boardMenuPopup-title"}}
        a.close-btn.js-close-pop-over(href="#", aria-label="{{t $.L `close`}}") ×
      .content
        ul.pop-over-list
          if .CanEdit
            li
              a.js-open-rules-view(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules", title="{{t $.L `rules`}}")
                i.fa.fa-magic
                |  {{t $.L "rules"}}
            li
              a.js-open-rules-list-view(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules?view=list", title="{{t $.L `r-list-view`}}")
                i.fa.fa-list
                |  {{t $.L "r-list-view"}}
            li
              a.js-open-rules-workflow-view(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules?view=workflow", title="{{t $.L `r-workflow-view`}}")
                i.fa.fa-sitemap
                |  {{t $.L "r-workflow-view"}}
            li
              a.js-open-rules-import-export(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules?view=import", title="{{t $.L `rulesImportExportPopup-title`}}")
                i.fa.fa-exchange
                |  {{t $.L "rulesImportExportPopup-title"}}
    if .CanEdit
      //- WeKan's rulesImportExportPopup.
      template.js-pop-over-template(data-pop="rules-import-export", data-title="{{t $.L `rulesImportExportPopup-title`}}")
        .rules-import-export
          h3 {{t $.L "r-export"}}
          .rules-ie-btns
            a.button.primary.full.js-rules-export-json(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules/export?format=json", download="wekan-rules.json") {{t $.L "r-export-json"}}
            a.button.primary.full.js-rules-export-csv(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules/export?format=csv", download="wekan-rules.csv") {{t $.L "r-export-csv"}}
          hr
          h3 {{t $.L "r-import"}}
          p.rules-ie-hint {{t $.L "r-import-paste"}}
          textarea.rules-ie-textarea.js-rules-import-text(rows="8")
          .rules-ie-btns
            button.primary.full.js-rules-import-json(type="button") {{t $.L "r-import-json"}}
          p.js-rules-import-message
    .rules-back-to-board
      a.js-rules-back-to-board(href="/b/{{.Board.ID}}/{{.Board.Slug}}", title="{{.Board.Title}}")
        i.fa.fa-arrow-left
        |  {{t $.L "back"}}
    if .CanEdit
      //- One step on the page at a time, as WeKan's rulesMain: each is a
        template, and the step shown is a copy of it.
      .js-rules-stage
      template.js-rules-pane(data-pane="list")
        .rules
          h2
            i.fa.fa-magic
            |  {{t $.L "r-board-rules"}}
          if .Rules
            .rules-toolbar
              button.primary.js-rules-select-all(type="button")
                i.fa.fa-check-square-o
                |  {{t $.L "r-select-all"}}
              button.primary.js-rules-select-none(type="button")
                i.fa.fa-square-o
                |  {{t $.L "r-unselect-all"}}
              button.primary.js-rules-delete-selected(type="button")
                i.fa.fa-trash
                |  {{t $.L "r-delete-selected"}}
          ul.rules-list
            each rule in .Rules
              li.rules-lists-item(data-rule-id="{{.ID}}")
                input.js-rule-select(type="checkbox", data-rule-id="{{.ID}}", aria-label="{{.Title}}")
                p {{.Title}}
                .rules-btns-group
                  button.primary.wide.js-goto-details(type="button", data-rule-id="{{.ID}}")
                    i.fa.fa-eye
                    |  {{t $.L "r-view-rule"}}
                  button.primary.wide.js-toggle-rule-enabled(type="button", data-rule-id="{{.ID}}", title="{{t $.L `r-toggle-rule-enabled`}}")
                    if .Enabled
                      i.fa.fa-toggle-on
                      |  {{t $.L "r-rule-enabled"}}
                    else
                      i.fa.fa-toggle-off
                      |  {{t $.L "r-rule-disabled"}}
                  button.primary.wide.js-delete-rule(type="button", data-rule-id="{{.ID}}")
                    i.fa.fa-trash
                    |  {{t $.L "r-delete-rule"}}
          .rules-add
            input#ruleTitle(type="text", placeholder="{{t $.L `r-add-rule`}}", aria-label="{{t $.L `r-add-rule`}}")
            button.primary.js-goto-trigger(type="button")
              i.fa.fa-plus
              |  {{t $.L "r-add-trigger"}}
      //- WeKan's rulesWorkflow: each rule as its trigger leading to its actions.
      template.js-rules-pane(data-pane="workflow")
        .rules-workflow
          h2
            i.fa.fa-sitemap
            |  {{t $.L "r-workflow-view"}}
          each rule in .Rules
            .workflow-rule(data-rule-id="{{.ID}}")
              .workflow-rule-title {{.Title}}
              .workflow-node.workflow-trigger {{.Trigger}}
              each act in .Actions
                .workflow-node.workflow-action {{.}}
      each rule in .Rules
        //- WeKan's ruleDetails: what the rule waits for, and what it does.
        template.js-rules-pane(data-pane="details-{{.ID}}")
          .rules
            h2
              i.fa.fa-magic
              |  {{t $.L "r-rule-details"}}
            .triggers-content
              .triggers-body
                .triggers-main-body
                  h4 {{t $.L "r-trigger"}}
                  .trigger-item
                    .trigger-content
                      .trigger-text {{.Trigger}}
                  h4 {{t $.L "r-action"}}
                  each act in .Actions
                    .trigger-item
                      .trigger-content
                        .trigger-text {{.}}
            .rules-back
              button.primary.wide.js-goback(type="button", data-to="list")
                i.fa.fa-arrow-left
                |  {{t $.L "back"}}
      template.js-rules-pane(data-pane="trigger")
        h2
          i.fa.fa-magic
          |  {{t $.L "r-rule"}} "
          span.js-rule-name
          | " - {{t $.L "r-add-trigger"}}
        .triggers-content
          .triggers-body
            .triggers-side-menu
              ul
                li.active.js-set-board-triggers(data-tab="board")
                  i.fa.fa-bar-chart
                li.js-set-card-triggers(data-tab="card")
                  i.fa.fa-file-text-o
                li.js-set-checklist-triggers(data-tab="checklist")
                  i.fa.fa-check
                li.js-set-button-triggers(data-tab="button", title="{{t $.L `r-set-button-triggers`}}")
                  i.fa.fa-hand-pointer-o
            .triggers-main-body
              p.rules-vars-hint.js-trigger-vars-hint {{t $.L "r-trigger-vars-hint"}}
              //- #3195: insert a rule variable into the text field last focused.
              label.rule-variable-picker
                span {{t $.L "r-insert-variable"}}
                select.js-rule-variable-picker
                  option(value="") -
                  each tok in $.RuleTokens
                    option(value="{{.}}") {{.}}
              .js-rules-tab(data-tab="board")
                .trigger-item#trigger-two
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-card"}}
                    .trigger-text {{copula $.L}}
                    .trigger-text {{t $.L "r-added-to"}}
                    .trigger-text {{t $.L "r-list"}}
                    .trigger-dropdown
                      textarea#create-list-name(rows="2", placeholder="{{t $.L `r-list-name`}}")
                    .trigger-text {{t $.L "r-in-swimlane"}}
                    .trigger-dropdown
                      textarea#create-swimlane-name(rows="2", placeholder="{{t $.L `r-swimlane-name`}}")
                  button.trigger-button.js-add-create-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item#trigger-three
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-card"}}
                    .trigger-text {{t $.L "r-is-moved"}}
                  button.trigger-button.js-add-gen-moved-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item#trigger-four
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-card"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#move-action
                        option(value="moved-to") {{t $.L "r-moved-to"}}
                        option(value="moved-from") {{t $.L "r-moved-from"}}
                    .trigger-text {{t $.L "r-list"}}
                    .trigger-dropdown
                      textarea#move-list-name(rows="2", placeholder="{{t $.L `r-list-name`}}")
                    .trigger-text {{t $.L "r-in-swimlane"}}
                    .trigger-dropdown
                      textarea#create-swimlane-name-2(rows="2", placeholder="{{t $.L `r-swimlane-name`}}")
                  button.trigger-button.js-add-moved-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                //- #2076: a card moved forward (to a later list) or back (to an
                  earlier one), in the board's list order.
                .trigger-item#trigger-move-direction
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-card"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#move-direction
                        option(value="forward") {{t $.L "r-moved-forward"}}
                        option(value="back") {{t $.L "r-moved-back"}}
                  button.trigger-button.js-add-move-direction-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item#trigger-five
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-card"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#arch-action
                        option(value="archived") {{t $.L "r-archived"}}
                        option(value="unarchived") {{t $.L "r-unarchived"}}
                        option(value="commented") {{t $.L "r-commented"}}
                  button.trigger-button.js-add-arch-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
              .js-rules-tab.is-hidden(data-tab="card")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-label-is"}}
                    .trigger-dropdown
                      select#label-action
                        option(value="added") {{t $.L "r-added-to"}}
                        option(value="removed") {{t $.L "r-removed-from"}}
                    .trigger-text {{t $.L "r-a-card"}}
                  button.trigger-button.js-add-gen-label-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    if not (nameBeforeSubject $.L)
                      .trigger-text {{t $.L "r-when-the-label"}}
                    .trigger-dropdown
                      select#spec-label
                        each lb in $.Labels
                          option(value="{{.ID}}") {{.Name}}
                    if nameBeforeSubject $.L
                      .trigger-text {{t $.L "r-when-the-label"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#spec-label-action
                        option(value="added") {{t $.L "r-added-to"}}
                        option(value="removed") {{t $.L "r-removed-from"}}
                    .trigger-text {{t $.L "r-a-card"}}
                  button.trigger-button.js-add-spec-label-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-member"}}
                    .trigger-dropdown
                      select#gen-member-action
                        option(value="added") {{t $.L "r-added-to"}}
                        option(value="removed") {{t $.L "r-removed-from"}}
                    .trigger-text {{t $.L "r-a-card"}}
                  button.trigger-button.js-add-gen-member-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    if not (nameBeforeSubject $.L)
                      .trigger-text {{t $.L "r-when-the-member"}}
                    .trigger-dropdown
                      input#spec-member(type="text", placeholder="{{t $.L `r-name`}}")
                    if nameBeforeSubject $.L
                      .trigger-text {{t $.L "r-when-the-member"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#spec-member-action
                        option(value="added") {{t $.L "r-added-to"}}
                        option(value="removed") {{t $.L "r-removed-from"}}
                    .trigger-text {{t $.L "r-a-card"}}
                  button.trigger-button.js-add-spec-member-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-assignee"}}
                    .trigger-dropdown
                      select#gen-assignee-action
                        option(value="added") {{t $.L "r-added-to"}}
                        option(value="removed") {{t $.L "r-removed-from"}}
                    .trigger-text {{t $.L "r-a-card"}}
                  button.trigger-button.js-add-gen-assignee-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    if not (nameBeforeSubject $.L)
                      .trigger-text {{t $.L "r-when-the-assignee"}}
                    .trigger-dropdown
                      input#spec-assignee(type="text", placeholder="{{t $.L `r-name`}}")
                    if nameBeforeSubject $.L
                      .trigger-text {{t $.L "r-when-the-assignee"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#spec-assignee-action
                        option(value="added") {{t $.L "r-added-to"}}
                        option(value="removed") {{t $.L "r-removed-from"}}
                    .trigger-text {{t $.L "r-a-card"}}
                  button.trigger-button.js-add-spec-assignee-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-attach"}}
                    .trigger-dropdown
                      select#attach-action
                        option(value="added") {{t $.L "r-attachment-added-to"}}
                        option(value="removed") {{t $.L "r-attachment-removed-from"}}
                    .trigger-text {{t $.L "r-a-card"}}
                  button.trigger-button.js-add-attachment-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                //- #2194: a card's title or description contains a text.
                .trigger-item(title="{{t $.L `text-contains-trigger-description`}}")
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-card-title-or-description-contains"}}
                    .trigger-dropdown
                      textarea.text-contains-trigger-value#text-contains-value(rows="2", placeholder="{{t $.L `text-contains-trigger-label`}}")
                  button.trigger-button.js-add-text-contains-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-due-date-changed"}}
                  button.trigger-button.js-add-due-date-changed-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-start-date-changed"}}
                  button.trigger-button.js-add-start-date-changed-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-end-date-changed"}}
                  button.trigger-button.js-add-end-date-changed-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-received-date-changed"}}
                  button.trigger-button.js-add-received-date-changed-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
              .js-rules-tab.is-hidden(data-tab="checklist")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-checklist"}}
                    .trigger-dropdown
                      select#gen-check-action
                        option(value="created") {{t $.L "r-added-to"}}
                        option(value="removed") {{t $.L "r-removed-from"}}
                    .trigger-text {{t $.L "r-a-card"}}
                  button.trigger-button.js-add-gen-check-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    if not (nameBeforeSubject $.L)
                      .trigger-text {{t $.L "r-when-the-checklist"}}
                    .trigger-dropdown
                      textarea#check-name(rows="2", placeholder="{{t $.L `r-name`}}")
                    if nameBeforeSubject $.L
                      .trigger-text {{t $.L "r-when-the-checklist"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#spec-check-action
                        option(value="created") {{t $.L "r-added-to"}}
                        option(value="removed") {{t $.L "r-removed-from"}}
                    .trigger-text {{t $.L "r-a-card"}}
                  button.trigger-button.js-add-spec-check-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-checklist"}}
                    .trigger-dropdown
                      select#gen-comp-check-action
                        option(value="completed") {{t $.L "r-completed"}}
                        option(value="uncompleted") {{t $.L "r-made-incomplete"}}
                  button.trigger-button.js-add-gen-comp-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    if not (nameBeforeSubject $.L)
                      .trigger-text {{t $.L "r-when-the-checklist"}}
                    .trigger-dropdown
                      textarea#spec-comp-check-name(rows="2", placeholder="{{t $.L `r-name`}}")
                    if nameBeforeSubject $.L
                      .trigger-text {{t $.L "r-when-the-checklist"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#spec-comp-check-action
                        option(value="completed") {{t $.L "r-completed"}}
                        option(value="uncompleted") {{t $.L "r-made-incomplete"}}
                  button.trigger-button.js-add-spec-comp-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "r-when-a-item"}}
                    .trigger-dropdown
                      select#check-item-gen-action
                        option(value="checked") {{t $.L "r-checked"}}
                        option(value="unchecked") {{t $.L "r-unchecked"}}
                  button.trigger-button.js-add-gen-check-item-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
                .trigger-item
                  .trigger-content
                    if not (nameBeforeSubject $.L)
                      .trigger-text {{t $.L "r-when-the-item"}}
                    .trigger-dropdown
                      textarea#check-item-name(rows="2", placeholder="{{t $.L `r-name`}}")
                    if nameBeforeSubject $.L
                      .trigger-text {{t $.L "r-when-the-item"}}
                    .trigger-text {{copula $.L}}
                    .trigger-dropdown
                      select#check-item-spec-action
                        option(value="checked") {{t $.L "r-checked"}}
                        option(value="unchecked") {{t $.L "r-unchecked"}}
                  button.trigger-button.js-add-spec-check-item-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
              .js-rules-tab.is-hidden(data-tab="button")
                .trigger-item#trigger-button
                  .trigger-content
                    .trigger-text {{t $.L "r-button-label"}}
                    .trigger-dropdown
                      textarea#button-label(rows="2", placeholder="{{t $.L `r-button-label`}}")
                    .trigger-dropdown
                      select#button-type.js-button-type
                        option(value="card", selected) {{t $.L "r-card-button"}}
                        option(value="board") {{t $.L "r-board-button"}}
                  button.trigger-button.js-add-button-trigger.js-goto-action(type="button", aria-label="{{t $.L `r-add-trigger`}}")
                    i.fa.fa-plus(aria-hidden="true")
        .rules-back
          button.primary.wide.js-goback(type="button", data-to="list")
            i.fa.fa-arrow-left
            |  {{t $.L "back"}}
      template.js-rules-pane(data-pane="action")
        h2
          i.fa.fa-magic
          |  {{t $.L "r-rule"}} "
          span.js-rule-name
          | " - {{t $.L "r-add-action"}}
        .triggers-content
          .triggers-body
            .triggers-side-menu
              ul
                li.active.js-set-board-actions(data-tab="board-actions")
                  i.fa.fa-bar-chart
                li.js-set-card-actions(data-tab="card-actions")
                  i.fa.fa-file-text-o
                li.js-set-checklist-actions(data-tab="checklist-actions")
                  i.fa.fa-check
            .triggers-main-body
              //- #3195: insert a rule variable into the text field last focused.
              label.rule-variable-picker
                span {{t $.L "r-insert-variable"}}
                select.js-rule-variable-picker
                  option(value="") -
                  each tok in $.RuleTokens
                    option(value="{{.}}") {{.}}
              .js-rules-tab(data-tab="board-actions")
                //- WeKan's boardActions: copy the card to a list and swimlane of
                  a board the user may change.
                .trigger-item
                  .trigger-content
                    .trigger-text {{t $.L "copyCardPopup-title"}}
                    .trigger-text {{t $.L "r-the-board"}}
                    .trigger-dropdown
                      select#board-id-copy(aria-label="{{t $.L `board`}}")
                        each cb in $.CopyBoards
                          if .Current
                            option(value="{{.ID}}", selected) {{t $.L "current"}}
                          else
                            option(value="{{.ID}}") {{.Title}}
                    .trigger-text {{t $.L "r-in-list"}}
                    .trigger-dropdown
                      select#list-id-copy(aria-label="{{t $.L `list`}}")
                        each cb in $.CopyBoards
                          each l in .Lists
                            option(value="{{.ID}}", data-board="{{.Board}}") {{.Title}}
                    .trigger-text {{t $.L "r-in-swimlane"}}
                    .trigger-dropdown
                      select#swimlane-id-copy(aria-label="{{t $.L `swimlane`}}")
                        each cb in $.CopyBoards
