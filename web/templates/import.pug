.wrapper.import-page(class="{{if .Report}}has-import-report{{end}}")
  if .Error
    .warning {{t $.L .Error}}
  //- WeKan's loss report: what an import that completed with warnings could
    not bring over, before its board opens.
  if .Report
    .import-report.js-import-report
      h2 {{t $.L "import-report-heading"}}
      p {{t $.L "import-report-description"}}
      ul
        each d in .Report.Rows
          li.import-report-row {{.}}
      a.primary.button.js-open-imported-board(href="{{.Report.BoardURL}}") {{t $.L "import-report-open-board"}}
  //- WeKan's map-members step: the file's people, each to be mapped to an
    existing user by username; who is left unmapped becomes a placeholder.
  else if .MapMembers
    h2 {{t $.L "import-map-members"}}
    .map-members
      p {{t $.L "import-members-map"}}
      p.import-members-map-note {{t $.L "import-members-map-note"}}
      form(method="post", action="{{.MapMembers.Action}}")
        input(type="hidden", name="payload", value="{{.MapMembers.Payload}}")
        if .MapMembers.Split
          input(type="hidden", name="splitBy", value="swimlane")
        .mapping-list
          each p in .MapMembers.People
            .mapping-item.js-select-member
              .profile-source
                .full-name {{.Name}}
                .username ({{.Key}})
              .wekan
                input(type="hidden", name="key-{{.Index}}", value="{{.Key}}")
                input.js-map-member-username(type="text", name="map-{{.Index}}", placeholder="{{t $.L `username`}}", aria-label="{{t $.L `username`}}")
        input.primary.wide(type="submit", value="{{t $.L `done`}}")
        button.primary.wide.js-import-skip-mapping(type="submit", name="skipMapping", value="1") {{t $.L "import-without-mapping-members"}}
  else if .Mapping
    form.import-csv-mapping.js-csv-mapping(method="post", action="/import/{{.Source}}/board")
      h2 {{t $.L "csv-mapping-title"}}
      p {{t $.L "csv-mapping-description"}}
      if .BoardsText
        p.quiet.js-csv-mapping-boards {{t $.L "csv-mapping-boards"}} {{.BoardsText}}
      if .SkippedText
        p.quiet.js-csv-mapping-skipped {{t $.L "csv-mapping-skipped-sheets"}} {{.SkippedText}}
      textarea(name="rows", hidden) {{.Rows}}
      if .Sheets
        textarea(name="sheets", hidden) {{.Sheets}}
      input(type="hidden", name="boardTitle", value="{{.BoardTitle}}")
      table.csv-mapping-fields
        tbody
          each f in .Fields
            tr(class="csv-mapping-field-{{.Field}}")
              th
                label(for="csv-map-{{.Field}}") {{.Label}}
              td
                select.js-csv-map-field(id="csv-map-{{.Field}}", name="map-{{.Field}}", data-field="{{.Field}}")
                  option(value="") {{t $.L "csv-mapping-not-in-file"}}
                  each o in .Options
                    if .Selected
                      option(value="{{.Index}}", selected) {{.Text}}
                    else
                      option(value="{{.Index}}") {{.Text}}
      .csv-mapping-list-name(class="{{if .ListMissing}}js-csv-mapping-list-missing{{end}}")
        p {{t $.L "csv-mapping-list-missing"}}
        label(for="csv-map-list-name") {{t $.L "csv-mapping-list-name"}}
        input.js-csv-map-list-name(id="csv-map-list-name", type="text", name="listName", maxlength="255", value="{{.ListName}}")
      if .Extra
        .csv-mapping-custom-fields
          p {{t $.L "csv-mapping-custom-fields"}}
          ul
            each c in .Extra
              li
                label.flex
                  input.js-csv-map-custom-column(type="checkbox", name="custom", value="{{.Index}}")
                  span {{.Text}}
      button.primary.wide.js-csv-mapping-import(type="submit") {{t $.L "import"}}
  else
    form(method="post", action="/import/{{.Source}}", enctype="multipart/form-data")
      p: label(for="import-textarea") {{.Instruction}}
      p.import-file-row
        label(for="import-file") {{t $.L "import-file-label"}}
        input.js-import-file(id="import-file", type="file", name="file", accept="{{.Accept}}")
      if .Paste
        textarea.js-import-json(id="import-textarea", name="text", rows="10")
      //- WeKan's "People in the file": each mapped to an existing user (the
        members-mapping step; nobody mapped is a placeholder), placeholder
        users keeping the names, or the person importing.
      if .General
        .import-members-mode
          p
            strong {{t $.L "import-members-mode-heading"}}
          input.js-import-members-mode-value(type="hidden", name="membersMode", value="map")
          each m in .MembersModes
            a.flex.js-import-members-mode(data-mode="{{.Mode}}", href="#")
              .materialCheckBox(class="{{if .Checked}}is-checked{{end}}")
              span {{t $.L .Label}}
      //- "One board per project" (import_split.go): each swimlane the import
        would make becomes its own board.
      if .General
        //- A div, not WeKan's p: the box is a div, and a parser closes a p
          at one, which split the link in two.
        .import-file-row
          input.js-import-split-value(type="hidden", name="splitBy", value="")
          a.flex.js-import-split-toggle(href="#")
            .materialCheckBox
            span {{t $.L "import-one-board-per-project"}}
          span.quiet.import-file-hint {{t $.L "import-one-board-per-project-hint"}}
      //- WeKan's "Import" - with "map", the members-mapping step first - and
        its "Import without mapping members".
      if .General
        input.primary.wide(type="submit", value="{{t $.L `import`}}")
        button.primary.wide.js-import-without-mapping(type="submit", name="skipMapping", value="1") {{t $.L "import-without-mapping-members"}}
      else
        input.primary.wide(type="submit", value="{{t $.L `import`}}")
