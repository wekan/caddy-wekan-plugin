.setting-content.board-webhooks(data-integrations="{{.Endpoint}}")
  h1
    if .Board
      a.js-back-to-board(href="/b/{{.Board.ID}}/{{.Board.Slug}}") {{.Board.Title}}
    else
      a(href="/admin/notifications") {{t $.L "admin-panel"}}
    |  - {{.Title}}
  p.error.js-webhook-error(role="alert", hidden) {{t $.L "error"}}
  if .AccountWebhook
    section
      h2 {{t $.L "webhook-internal-hosts"}}
      form(method="post", action="/admin/settings/global-webhooks/internal")
        label
          | {{t $.L "webhook-internal-hosts"}}
          textarea(name="hosts", rows="5", maxlength="16000") {{.InternalHosts}}
        button(type="submit") {{t $.L "save"}}
    section
      h2 {{t $.L "account-webhook"}}
      form(method="post", action="/admin/settings/global-webhooks/account")
        label
          | {{t $.L "settings-group-url"}}
          input(type="url", name="url", maxlength="2000", value="{{.AccountWebhook.URL}}")
        label
          | {{t $.L "webhook-token"}}
          input(type="password", name="token", maxlength="500", autocomplete="new-password")
        if .AccountWebhook.HasToken
          label
            input(type="checkbox", name="clearToken", value="1")
            |  {{t $.L "delete"}}
        label
          | <input type="checkbox" name="onLogin" value="1" {{if .AccountWebhook.OnLogin}}checked{{end}}>
          |  {{t $.L "account-webhook-on-login"}}
        label
          | <input type="checkbox" name="onRegister" value="1" {{if .AccountWebhook.OnRegister}}checked{{end}}>
          |  {{t $.L "account-webhook-on-register"}}
        fieldset
          legend {{t $.L "account-webhook-fields"}}
          each field in .AccountWebhook.Fields
            label
              | <input type="checkbox" name="fields" value="{{.Name}}" {{if .Enabled}}checked{{end}}>
              |  {{t $.L .Label}}
        button(type="submit") {{t $.L "save"}}
  each hook in .Hooks
    form.js-board-hook(method="post", data-hook="{{.ID}}")
      label
        | {{t $.L "webhook-title"}}
        input(type="text", name="title", value="{{.Title}}")
      label
        | {{t $.L "settings-group-url"}}
        input(type="url", name="url", required, value="{{.URL}}")
      label
        | {{t $.L "webhook-token"}}
        input(type="password", name="token", autocomplete="off")
      label
        if .Enabled
          input(type="checkbox", name="enabled", checked)
        else
          input(type="checkbox", name="enabled")
        | {{t $.L "webhooks-report-on"}}
      label
        | {{t $.L "type"}}
        select(name="type")
          if .TwoWay
            option(value="outgoing-webhooks") {{t $.L "outgoing-webhooks"}}
            option(value="bidirectional-webhooks", selected) {{t $.L "bidirectional-webhooks"}}
          else
            option(value="outgoing-webhooks", selected) {{t $.L "outgoing-webhooks"}}
            option(value="bidirectional-webhooks") {{t $.L "bidirectional-webhooks"}}
      fieldset.js-webhook-activities
        legend {{t $.L "webhook-activities"}}
        label
          if .AllActivities
            input(type="checkbox", name="allActivities", checked)
          else
            input(type="checkbox", name="allActivities")
          | {{t $.L "webhook-activities-all"}}
        each group in .Groups
          label
            if .Checked
              input(type="checkbox", name="activityGroup", value="{{.Activities}}", checked)
            else
              input(type="checkbox", name="activityGroup", value="{{.Activities}}")
            | {{t $.L .Label}}
      button.primary(type="submit") {{t $.L "save"}}
      button(type="submit", value="delete", formnovalidate) {{t $.L "delete"}}
  form.js-board-hook(method="post")
    label
      | {{t $.L "settings-group-url"}}
      input(type="url", name="url", required)
    label
      | {{t $.L "webhook-title"}}
      input(type="text", name="title")
    label
      | {{t $.L "webhook-token"}}
      input(type="password", name="token", autocomplete="off")
    label
      | {{t $.L "type"}}
      select(name="type")
        option(value="outgoing-webhooks") {{t $.L "outgoing-webhooks"}}
        option(value="bidirectional-webhooks") {{t $.L "bidirectional-webhooks"}}
    button.primary(type="submit") {{t $.L "add"}}
  script(src="/static/board-webhooks.js", defer)
