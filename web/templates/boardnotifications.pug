//- WeKan's Board Settings / Notifications, its delivery part (#3695 / #5171):
  how this board's e-mail, tray and webhooks deliver, for the board's admins.
  A member's own setting, and a webhook's own, win over this.
.setting-content.board-notifications
  h1
    a.js-back-to-board(href="/b/{{.Board.ID}}/{{.Board.Slug}}") {{.Board.Title}}
    |  - {{t $.L "notifications"}}
  if .Saved
    p.cloud-saved.js-delivery-saved {{t $.L "cloud-saved"}}
  if .Error
    p.at-error.js-delivery-error {{t $.L "notification-delivery-invalid"}}
  | {{template "_delivery" .}}
  //- Each webhook's own delivery, WeKan's outgoingWebhooksPopup: it wins
    over the board's above.
  each h in .Hooks
    .board-notifications-hook(data-hook="{{.ID}}")
      h2 {{t $.L "outgoing-webhooks"}}: {{.Title}}
      | {{template "_delivery" .}}
