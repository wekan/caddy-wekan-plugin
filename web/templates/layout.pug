doctype html
html(lang="{{.L}}", dir="{{if .Lang.RTL}}rtl{{else}}ltr{{end}}", data-browser-language-tags="{{.BrowserLanguageTags}}", data-calendar-system="{{if .User}}{{.DateSettings.Calendar}}{{end}}", data-start-day="{{if .User}}{{.DateSettings.StartDay}}{{end}}", data-date-format="{{if .User}}{{if .DateSettings.Override}}{{.DateSettings.Format}}{{end}}{{end}}")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title {{.Title}} - WeKan
    link(rel="stylesheet", href="/static/vendor/unpoly.min.css")
    link(rel="stylesheet", href="/static/wekan.css")
    script(src="/static/vendor/unpoly.min.js")
    script(src="/static/vendor/interact.min.js")
    script(src="/static/weddy.js")
  body(data-submit-on-enter="{{if .User}}{{if .User.Profile.SubmitOnEnter}}true{{end}}{{end}}", class="{{if .User}}{{if .User.Profile.HideFocusOutline}}has-hide-focus-outline{{end}}{{end}}")
    if .User
      #header.header-bar
        a.header-all-boards.js-all-boards(href="/", up-follow) {{t $.L "all-boards"}}
        if .Board
          //- WeKan's header quick access: Home, the toggle that collapses the
            header's icons, and the board's title, renamed by its admin; then
            the mobile/desktop toggle, the first of the icons it collapses.
          #header-quick-access.nodragscroll(role="navigation", aria-label="{{t $.L `all-boards`}}")
            span.home-icon.allBoards
              a.header-home-link(href="/", up-follow, title="{{t $.L `all-boards`}}", aria-label="{{t $.L `all-boards`}}")
                i.fa.fa-home
              a.board-header-btn.js-toggle-header-icons-collapsed(href="#", title="{{t $.L `toggle-header-icons-collapsed`}}", aria-label="{{t $.L `toggle-header-icons-collapsed`}}")
                i.fa.fa-angle-double-left
              if .Board.AdminOf .User.ID
                span.header-page-title.js-edit-board-title.is-editable(role="heading", aria-level="1", title="{{.Board.Title}}") {{.Board.Title}}
                template.js-pop-over-template(data-pop="board-title", data-title="{{t $.L `rename`}}")
                  form(method="post", action="/b/{{.Board.ID}}/title")
                    label
                      | {{t $.L "title"}}
                      textarea.js-board-name(name="title", rows="2", dir="auto", required) {{.Board.Title}}
                    label
                      | {{t $.L "description"}}
                      textarea.js-board-desc(name="description", dir="auto") {{.Board.Description}}
                    input.primary.wide(type="submit", value="{{t $.L `rename`}}")
              else
                span.header-page-title(role="heading", aria-level="1", title="{{.Board.Title}}") {{.Board.Title}}
            .mobile-mode-toggle.js-header-collapsible-icon
              a.board-header-btn.js-mobile-mode-toggle.desktop-active(href="#", title="{{t $.L `mobile-desktop-toggle`}}", aria-label="{{t $.L `mobile-desktop-toggle`}}", data-profile="{{.User.MobileModeChoice}}")
                i.desktop-icon
                  i.fa.fa-desktop
        if .MayCreateBoard
          //- WeKan's header.jade: the Create Board pop-over (createBoardForm).
          a#header-new-board-icon.board-header-btn.js-create-board(href="#", title="{{t $.L `add-board`}}", aria-label="{{t $.L `add-board`}}")
            i.fa.fa-plus
          template.js-pop-over-template(data-pop="create-board", data-title="{{t $.L `add-board`}}")
            form.js-create-board-form(method="post", action="/boards")
              label
                | {{t $.L "title"}}
                textarea.js-new-board-title(name="title", rows="3", dir="auto", placeholder="{{t $.L `bucket-example`}}", required)
              fieldset.multiline-title-choice
                legend {{t $.L "add-many-lines-as"}}
                label
                  input.js-multiline-title-mode(type="radio", name="titleMode", value="one", checked)
                  |  1 {{t $.L "board"}}
                label
                  input.js-multiline-title-mode(type="radio", name="titleMode", value="separate")
                  |  {{tv $.L "many-items" "items" (t $.L "boards")}}
              input.primary.wide(type="submit", value="{{t $.L `create`}}")
        if .User.IsAdmin
          a.js-admin-people(href="/admin/people") {{t $.L "admin-panel"}} / {{t $.L "people"}}
          a.js-admin-notifications(href="/admin/notifications") {{t $.L "admin-panel"}} / {{t $.L "notifications"}}
        if .CloudMenu
          a.js-cloud-settings(href="/admin/people/cloud") {{t $.L "admin-panel"}} / {{t $.L "people"}} / {{t $.L "cloud"}}
        if .PanelMenu
          a.js-cloud-panel(href="/cloud") {{t $.L "cloud"}}
        a(href="/language", title="{{t $.L `changeLanguagePopup-title`}}") {{.Lang.Name}}
        #notifications.notifications
          a.notifications-drawer-toggle.js-toggle-notifications-drawer(href="#", class="{{if .Unread}}alert{{end}}", title="{{t $.L `notifications`}}", aria-label="{{t $.L `notifications`}}", data-unread="{{.Unread}}") 🔔
            span.notifications-count {{if .Unread}}{{.Unread}}{{end}}
        //- WeKan's notificationsDrawer.
        section#notifications-drawer.is-hidden
          .header
            a.notification-menu-toggle(href="#", title="{{t $.L `menu`}}") ☰
            .notification-menu.is-hidden
              //- WeKan's filters: the unread ones by default, or all of them.
              a.menu-item.js-filter-unread.selected(href="#") {{t $.L "filter-by-unread"}}
              a.menu-item.js-view-all(href="#") {{t $.L "view-all"}}
              a.menu-item.mark-all-read(href="#") {{t $.L "mark-all-as-read"}}
              a.menu-item.delete-all(href="#", data-confirm="{{t $.L `delete-all-notifications-confirm`}}") {{t $.L "delete-all-notifications"}}
            h5 {{t $.L "notifications"}}
            a.close(href="#", title="{{t $.L `close`}}") ×
          ul.notifications
            //- #5171: one card's or board's entries in one row, when the tray
              grouping says so; the first shows until the row is opened.
            each g in .Drawer
              if .Collapsible
                li.notification-group(data-key="{{.Key}}")
                  a.js-toggle-notification-group(href="#", data-key="{{.Key}}", aria-expanded="false") ▸ {{.Label}}
              each n in .Items
                li.notification(class="{{if .Read}}is-read{{end}}{{if .Rest}} is-group-rest{{end}}", data-activity="{{.ActivityID}}", data-group="{{.Group}}")
                  .notification-clear-item {{.HTML}}
                  .notification-date
                    small.quiet {{.Display}}
        a.header-user.js-open-header-member-menu(href="/profile") {{memberName .User}}
        //- WeKan's sidebar hamburger (header.jade): at the end of the username,
          in the bar that is always on screen, on a board - the sidebar opens
          below this bar, so it never covers it.
        if .Lanes
          .board-header-btns.header-sidebar-toggle
            .separator
            a.board-header-btn.js-toggle-page-sidebar(href="#", title="{{t $.L `sidebar-open`}} {{t $.L `or`}} {{t $.L `sidebar-close`}}", aria-label="{{t $.L `sidebar-open`}}") ☰
        //- WeKan's memberMenuPopup: what Weddy has of it.
        template.js-pop-over-template(data-pop="member-menu", data-title="{{t $.L `memberMenuPopup-title`}}")
          .content
            ul.pop-over-list
              li
                a(href="/", up-follow)
                  i.fa.fa-home
                  |  {{t $.L "all-boards"}}
              if .User.IsAdmin
                li
                  a.js-go-setting(href="/admin/people")
                    i.fa.fa-lock
                    |  {{t $.L "admin-panel"}}
              hr
              li
                a.board-header-btn.js-open-archived-board(href="/allboards/archive")
                  i.fa.fa-archive
                  |  {{t $.L "archives"}}
              hr
              li
                a.js-edit-profile(href="#")
                  i.fa.fa-user
                  |  {{t $.L "edit-profile"}}
              li
                a.js-change-password(href="/profile")
                  i.fa.fa-key
                  |  {{t $.L "changePasswordPopup-title"}}
              li
                a.js-change-language(href="/language")
                  i.fa.fa-globe
                  |  {{t $.L "changeLanguagePopup-title"}}
              li
                a.js-member-date-settings(href="#")
                  i.fa.fa-calendar
                  |  {{t $.L "date"}}
              li
                a.js-change-settings(href="#")
                  i.fa.fa-cog
                  |  {{t $.L "change-settings"}}
        //- WeKan's changeSettingsPopup.
        template.js-pop-over-template(data-pop="change-settings", data-popup="changeSettingsPopup", data-title="{{t $.L `changeSettingsPopup-title`}}")
          .content
            ul.pop-over-list.change-settings-list
              li
                a.js-toggle-desktop-drag-handles(href="#", role="switch", aria-checked="{{.User.Profile.ShowDesktopDragHandles}}")
                  i.fa.fa-arrows
                  |  {{t $.L "show-desktop-drag-handles"}}
                  i.fa.fa-check(aria-hidden="true")
              li
                a.js-toggle-hide-focus-outline(href="#", role="switch", aria-checked="{{if .User.Profile.HideFocusOutline}}false{{else}}true{{end}}")
                  i.fa.fa-square-o
                  |  {{t $.L "show-focus-outline"}}
                  i.fa.fa-check(aria-hidden="true")
              li
                a.js-toggle-submit-on-enter(href="#", title="{{t $.L `submit-on-enter-description`}}")
                  i.fa.fa-level-down
                  |  {{t $.L "submit-on-enter"}}
                  i.fa.fa-check.js-submit-on-enter-check(hidden)
            //- Weddy applies each setting as it is clicked; Apply closes, as
              WeKan's js-apply-user-settings does after saving.
            button.primary.js-apply-user-settings(type="button") {{t $.L "apply"}}
        //- WeKan's memberDateSettingsPopup (dateFormatSettings.jade): the
          member's date format, first day of the week and calendar (#4335).
        if .User
          template.js-pop-over-template(data-pop="member-date-settings", data-title="{{t $.L `date-format`}}")
            .content
              form.js-date-format-form
                strong.js-member-date-format-heading {{t $.L "memberMenuPopup-title"}}: {{t $.L "date-format"}}
                label.flex
                  if .DateSettings.Override
                    input.js-date-format-override(type="checkbox", checked)
                  else
                    input.js-date-format-override(type="checkbox")
                  span.js-member-date-format-enabled {{t $.L "date-format"}}
                select.js-date-format-select(aria-label="{{t $.L `date-format`}}")
                  each o in .DateSettings.Formats
                    if .Selected
                      option(value="{{.Value}}", selected) {{.Name}}
                    else
                      option(value="{{.Value}}") {{.Name}}
                hr
                label.bold.clear(for="start-day-of-week")
                  i.fa.fa-calendar
                  |  {{t $.L "start-day-of-week"}}
                select#start-day-of-week
                  each o in .DateSettings.Days
                    if .Selected
                      option(value="{{.Value}}", selected) {{.Name}}
                    else
                      option(value="{{.Value}}") {{.Name}}
                hr
                label.bold.clear(for="calendar-system")
                  i.fa.fa-calendar-check-o
                  |  {{t $.L "calendar-system"}}
                //- Display-only: dates stay stored as Gregorian.
                select#calendar-system
                  each o in .DateSettings.Calendars
                    if .Selected
                      option(value="{{.Value}}", selected) {{.Name}}
                    else
                      option(value="{{.Value}}") {{.Name}}
                p.error.js-date-format-error(hidden)
                button.primary(type="submit") {{t $.L "save"}}
        //- WeKan's editProfilePopup.
        template.js-pop-over-template(data-pop="edit-profile", data-title="{{t $.L `editProfilePopup-title`}}")
          form.js-edit-profile-form(method="post", action="/profile")
            label
              | {{t $.L "fullname"}}
              textarea.js-profile-fullname(name="fullname", rows="2") {{.User.Profile.Fullname}}
            label
              | {{t $.L "username"}}
              if .AllowUsernameChange
                input.js-profile-username(type="text", name="username", value="{{.User.Username}}", required)
              else
                input.js-profile-username(type="text", value="{{.User.Username}}", readonly)
            label
              | {{t $.L "initials"}}
              input.js-profile-initials(type="text", name="initials", value="{{.User.Profile.Initials}}", maxlength="8")
            label
              | {{t $.L "email"}}
              if .AllowEmailChange
                input.js-profile-email(type="email", name="email", value="{{.Email}}")
              else
                input.js-profile-email(type="email", value="{{.Email}}", readonly)
            .buttonsContainer
              input.primary.wide(type="submit", value="{{t $.L `save`}}")
        form.js-logout(method="post", action="/logout")
          button.js-logout-button(type="submit") {{t $.L "log-out"}}
    main#content
      | {{template "content" .}}
