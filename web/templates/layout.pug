doctype html
html(lang="{{.L}}", dir="{{if .Lang.RTL}}rtl{{else}}ltr{{end}}")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title {{.Title}} - WeKan
    link(rel="stylesheet", href="/static/vendor/unpoly.min.css")
    link(rel="stylesheet", href="/static/wekan.css")
    script(src="/static/vendor/unpoly.min.js")
    script(src="/static/vendor/interact.min.js")
    script(src="/static/weddy.js")
  body(data-submit-on-enter="{{if .User}}{{if .User.Profile.SubmitOnEnter}}true{{end}}{{end}}")
    if .User
      #header.header-bar
        a.header-all-boards.js-all-boards(href="/", up-follow) {{t $.L "all-boards"}}
        if .Board
          //- WeKan's header quick access: the board's title, renamed by its admin.
          #header-quick-access.nodragscroll
            if .Board.AdminOf .User.ID
              span.header-page-title.js-edit-board-title.is-editable(role="heading", aria-level="1", title="{{.Board.Title}}") {{.Board.Title}}
              template.js-pop-over-template(data-pop="board-title", data-title="{{t $.L `rename`}}")
                form(method="post", action="/b/{{.Board.ID}}/title")
                  label
                    | {{t $.L "title"}}
                    textarea.js-board-name(name="title", rows="2", dir="auto", required) {{.Board.Title}}
                  label
                    | {{t $.L "description"}}
                    textarea.js-board-desc(name="description", dir="auto") {{.Board.Description}}
                  input.primary.wide(type="submit", value="{{t $.L `rename`}}")
            else
              span.header-page-title(role="heading", aria-level="1", title="{{.Board.Title}}") {{.Board.Title}}
        if .MayCreateBoard
          //- WeKan's header.jade: the Create Board pop-over (createBoardForm).
          a#header-new-board-icon.board-header-btn.js-create-board(href="#", title="{{t $.L `add-board`}}", aria-label="{{t $.L `add-board`}}")
            i.fa.fa-plus
          template.js-pop-over-template(data-pop="create-board", data-title="{{t $.L `add-board`}}")
            form.js-create-board-form(method="post", action="/boards")
              label
                | {{t $.L "title"}}
                textarea.js-new-board-title(name="title", rows="3", dir="auto", placeholder="{{t $.L `bucket-example`}}", required)
              fieldset.multiline-title-choice
                legend {{t $.L "add-many-lines-as"}}
                label
                  input.js-multiline-title-mode(type="radio", name="titleMode", value="one", checked)
                  |  1 {{t $.L "board"}}
                label
                  input.js-multiline-title-mode(type="radio", name="titleMode", value="separate")
                  |  {{tv $.L "many-items" "items" (t $.L "boards")}}
              input.primary.wide(type="submit", value="{{t $.L `create`}}")
        if .User.IsAdmin
          a.js-admin-people(href="/admin/people") {{t $.L "admin-panel"}} / {{t $.L "people"}}
          a.js-admin-notifications(href="/admin/notifications") {{t $.L "admin-panel"}} / {{t $.L "notifications"}}
        if .CloudMenu
          a.js-cloud-settings(href="/admin/people/cloud") {{t $.L "admin-panel"}} / {{t $.L "people"}} / {{t $.L "cloud"}}
        if .PanelMenu
          a.js-cloud-panel(href="/cloud") {{t $.L "cloud"}}
        a.js-change-language(href="/language", title="{{t $.L `changeLanguagePopup-title`}}") {{.Lang.Name}}
        #notifications.notifications
          a.notifications-drawer-toggle.js-toggle-notifications-drawer(href="#", class="{{if .Unread}}alert{{end}}", title="{{t $.L `notifications`}}", aria-label="{{t $.L `notifications`}}", data-unread="{{.Unread}}") 🔔
            span.notifications-count {{if .Unread}}{{.Unread}}{{end}}
        //- WeKan's notificationsDrawer.
        section#notifications-drawer.is-hidden
          .header
            a.notification-menu-toggle(href="#", title="{{t $.L `menu`}}") ☰
            .notification-menu.is-hidden
              //- WeKan's filters: the unread ones by default, or all of them.
              a.menu-item.js-filter-unread.selected(href="#") {{t $.L "filter-by-unread"}}
              a.menu-item.js-view-all(href="#") {{t $.L "view-all"}}
              a.menu-item.mark-all-read(href="#") {{t $.L "mark-all-as-read"}}
              a.menu-item.delete-all(href="#", data-confirm="{{t $.L `delete-all-notifications-confirm`}}") {{t $.L "delete-all-notifications"}}
            h5 {{t $.L "notifications"}}
            a.close(href="#", title="{{t $.L `close`}}") ×
          ul.notifications
            //- #5171: one card's or board's entries in one row, when the tray
              grouping says so; the first shows until the row is opened.
            each g in .Drawer
              if .Collapsible
                li.notification-group(data-key="{{.Key}}")
                  a.js-toggle-notification-group(href="#", data-key="{{.Key}}", aria-expanded="false") ▸ {{.Label}}
              each n in .Items
                li.notification(class="{{if .Read}}is-read{{end}}{{if .Rest}} is-group-rest{{end}}", data-activity="{{.ActivityID}}", data-group="{{.Group}}")
                  .notification-clear-item {{.HTML}}
                  .notification-date
                    small.quiet {{.Display}}
        a.header-user.js-open-header-member-menu(href="/profile") {{memberName .User}}
        //- WeKan's memberMenuPopup: what Weddy has of it.
        template.js-pop-over-template(data-pop="member-menu", data-title="{{t $.L `memberMenuPopup-title`}}")
          ul.pop-over-list
            li
              a(href="/", up-follow)
                i.fa.fa-home
                |  {{t $.L "all-boards"}}
            if .User.IsAdmin
              li
                a.js-go-setting(href="/admin/people")
                  i.fa.fa-lock
                  |  {{t $.L "admin-panel"}}
            hr
            li
              a.board-header-btn.js-open-archived-board(href="/allboards/archive")
                i.fa.fa-archive
                |  {{t $.L "archives"}}
            hr
            li
              a.js-edit-profile(href="#")
                i.fa.fa-user
                |  {{t $.L "edit-profile"}}
            li
              a.js-change-password(href="/profile")
                i.fa.fa-key
                |  {{t $.L "changePasswordPopup-title"}}
            li
              a.js-change-language(href="/language")
                i.fa.fa-globe
                |  {{t $.L "changeLanguagePopup-title"}}
            li
              a.js-change-settings(href="#")
                i.fa.fa-cog
                |  {{t $.L "change-settings"}}
        //- WeKan's changeSettingsPopup: what Weddy has of it.
        template.js-pop-over-template(data-pop="change-settings", data-title="{{t $.L `changeSettingsPopup-title`}}")
          ul.pop-over-list
            li
              a.js-toggle-submit-on-enter(href="#", title="{{t $.L `submit-on-enter-description`}}")
                i.fa.fa-level-down
                |  {{t $.L "submit-on-enter"}}
                i.fa.fa-check.js-submit-on-enter-check(hidden)
        //- WeKan's editProfilePopup.
        template.js-pop-over-template(data-pop="edit-profile", data-title="{{t $.L `editProfilePopup-title`}}")
          form.js-edit-profile-form(method="post", action="/profile")
            label
              | {{t $.L "fullname"}}
              textarea.js-profile-fullname(name="fullname", rows="2") {{.User.Profile.Fullname}}
            label
              | {{t $.L "username"}}
              input.js-profile-username(type="text", value="{{.User.Username}}", readonly)
            label
              | {{t $.L "initials"}}
              input.js-profile-initials(type="text", name="initials", value="{{.User.Profile.Initials}}", maxlength="8")
            label
              | {{t $.L "email"}}
              if .AllowEmailChange
                input.js-profile-email(type="email", name="email", value="{{.Email}}")
              else
                input.js-profile-email(type="email", value="{{.Email}}", readonly)
            .buttonsContainer
              input.primary.wide(type="submit", value="{{t $.L `save`}}")
        form.js-logout(method="post", action="/logout")
          button.js-logout-button(type="submit") {{t $.L "log-out"}}
    main#content
      | {{template "content" .}}
