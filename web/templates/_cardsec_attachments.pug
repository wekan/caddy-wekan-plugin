//- The opened card's attachments section (card_sections.go), called with the page's data.
//- WeKan's attachmentGallery: a "+" opening cardAttachmentsPopup for
  whoever may change the card, and each attachment as a tile - its
  thumbnail or its extension, which opens attachmentViewer - with its
  name, size and actions.
.card-checklist-attachmentGallery.card-attachmentGallery
  h3.card-details-item-title.js-toggle-card-section(data-section="attachments", role="button", tabindex="0")
    i.fa.fa-caret-down
    i.fa.fa-paperclip
    |  {{t $.L "attachments"}}
  .attachment-gallery.attachments.js-attachments
    if .CanAddAttachment
      a.card-label.add-label.add-attachment.js-add-attachment(href="#", title="{{t $.L `add-attachment`}}", aria-label="{{t $.L `add-attachment`}}")
        i.fa.fa-plus
    each a in .Attachments
      .attachment-item.js-attachment(data-attachment="{{.ID}}")
        button.attachment-thumbnail-container.open-preview(type="button", aria-label="{{t $.L `preview`}}: {{.Name}}", data-attachment-id="{{.ID}}", data-kind="{{.PreviewKind}}", data-name="{{.Name}}", data-src="/cdn/storage/attachments/{{.ID}}/original/{{.Name}}")
          //- WeKan's #3275: the gallery shows an image's thumbnail, not the original.
          if .Thumbnail
            img.attachment-thumbnail(src="/cdn/storage/attachments/{{.ID}}/thumbnail", alt="{{.Name}}", title="{{.Name}}", loading="lazy")
          else if eq .Ext "svg"
            img.attachment-thumbnail(src="/cdn/storage/attachments/{{.ID}}", alt="{{.Name}}", title="{{.Name}}", type="image/svg+xml")
          else
            span.attachment-thumbnail-text {{.Ext}}
        .attachment-details-container
          .attachment-details
            div
              b.attachment-name {{.Name}}
              |  
              span.file-size ({{.SizeText}})
            .attachment-actions
              a.js-download(href="/cdn/storage/attachments/{{.ID}}/original/{{.Name}}?download=true", download="{{.Name}}", title="{{t $.L `download`}}", aria-label="{{t $.L `download`}}")
                i.fa.fa-arrow-down
              if $.CanAddAttachment
                form.js-attachment-delete(method="post", action="/attachments/{{.ID}}/delete", up-submit, up-target=".board-wrapper")
                  button.js-confirm-delete(type="submit", title="{{t $.L `delete`}}", aria-label="{{t $.L `delete`}}")
                    i.fa.fa-trash
                if eq .PreviewKind "image"
                  a.js-open-attachment-menu(href="#", data-attachment="{{.ID}}", title="{{t $.L `attachmentActionsPopup-title`}}", aria-label="{{t $.L `attachmentActionsPopup-title`}}")
                    i.fa.fa-bars
                  //- WeKan's attachmentActionsPopup: the card's cover, and
                    the board's background for a board admin.
                  template.js-pop-over-template(data-pop="attachment-actions-{{.ID}}", data-title="{{t $.L `attachmentActionsPopup-title`}}")
                    ul.pop-over-list
                      li
                        form(method="post", action="/attachments/{{.ID}}/cover", up-submit, up-target=".board-wrapper")
                          if eq .ID $.Card.CoverID
                            button.js-remove-cover(type="submit") {{t $.L "remove-cover"}}
                          else
                            button.js-add-cover(type="submit") {{t $.L "add-cover"}}
                      if $.IsBoardAdmin
                        li
                          form(method="post", action="/attachments/{{.ID}}/background", up-submit, up-target=".board-wrapper")
                            if eq (attachmentURL .ID) $.Board.BackgroundImageURL
                              button.js-remove-background-image(type="submit") {{t $.L "remove-background-image"}}
                            else
                              button.js-add-background-image(type="submit") {{t $.L "add-background-image"}}
