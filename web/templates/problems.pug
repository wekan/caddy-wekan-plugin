//- WeKan's Admin Panel / Problems / Recovery (adminProblems.jade): the
  e-mail delivery queue (emailRecoveryReports) and the pending activity
  notifications (activityNotificationRecoveryReports), ten a
  page, paused, resumed, cancelled and retried. The table is the report of
  activityNotificationRecoveryReport, filled by weddy.js; the strings it shows
  are below, in the user's language.
.setting-content.admin-reports-content
  .content-body
    .side-menu
      ul
        li.active
          a.js-left-menu-item(href="/admin/problems/recovery", data-id="report-recovery") {{t $.L "recoveryReportTitle"}}
        li
          a.js-left-menu-item(href="/admin/problems/password-length", data-id="report-password-length")
            i.fa.fa-key
            |  {{t $.L "password-length-report-title"}}
    .main-body
      h2.pane-title {{t $.L "recoveryReportTitle"}}
      //- WeKan's recovery events (report-recovery): what imports left out,
        among the data-safety actions, newest first, ten a page.
      section.recovery-events-report
        p.quiet {{t $.L "recovery-report-desc"}}
        form.table-page-controls.js-recovery-events(method="get", action="/admin/problems/recovery")
          input.js-table-page-search(type="search", name="q", value="{{.RecoverySearch}}", placeholder="{{t $.L `search`}}", aria-label="{{t $.L `search`}}")
          label(for="recovery-status") Show
          select#recovery-status(name="status")
            each o in .RecoveryStatuses
              if eq .Value $.RecoveryStatus
                option(value="{{.Value}}", selected) {{.Label}}
              else
                option(value="{{.Value}}") {{.Label}}
          button(type="submit") {{t $.L "search"}}
          span.table-page-total {{.RecoveryTotal}}
          .table-page-pagination
            if .RecoveryPrev
              a.js-recovery-prev(href="{{.RecoveryPrev}}", title="{{t $.L `previous`}}") &lt;
            span.table-page-page-info {{.RecoveryPage}} / {{.RecoveryPages}}
            if .RecoveryNext
              a.js-recovery-next(href="{{.RecoveryNext}}", title="{{t $.L `next`}}") &gt;
        if .RecoveryEvents
          .table-page-table-wrap
            table.table-page-table.recovery-events-table
              thead
                tr
                  th {{t $.L "done"}}
                  th {{t $.L "date"}}
                  th {{t $.L "recovery-event"}}
                  th User ID
                  th {{t $.L "username"}}
                  th {{t $.L "event-ipv4"}}
                  th {{t $.L "location"}}
                  th {{t $.L "event-ipv6"}}
                  th {{t $.L "location"}} (IPv6)
                  th {{t $.L "recovery-detail"}}
              tbody
                each e in .RecoveryEvents
                  tr(class="recovery-severity-{{.Severity}}")
                    td.nowrap
                      if .Done
                        i.fa.fa-check.table-page-status-done(title="true")
                      else
                        i.fa.fa-exclamation-triangle.table-page-status-failed(title="false")
                      if .Deleted
                        i.fa.fa-trash.table-page-status-deleted(title="Deleted data")
                    td.nowrap {{.Date}}
                    td {{.Type}}
                    td {{.UserID}}
                    td {{.Username}}
                    td {{.IPv4}}
                    td {{.IPv4Location}}
                    td {{.IPv6}}
                    td {{.IPv6Location}}
                    td {{.Detail}}
        else
          p.quiet.table-page-empty {{t $.L "recovery-no-events"}}
      section.email-recovery-reports
        h2 {{t $.L "email-recovery-heading"}}
        p.quiet {{t $.L "email-recovery-description"}}
        p.error.js-recovery-error(role="alert", hidden)
        p.quiet.js-recovery-busy(hidden) {{t $.L "email-recovery-saving"}}
        .table-page
          .table-page-controls
            input.js-table-page-search(type="search", placeholder="{{t $.L `search`}}", aria-label="{{t $.L `search`}}")
            button.js-table-page-action(data-action="refresh-email") {{t $.L "refresh"}}
            span.table-page-total
            .table-page-pagination
              button.js-table-page-prev(title="{{t $.L `previous`}}") &lt;
              span.table-page-page-info 1 / 1
              button.js-table-page-next(title="{{t $.L `next`}}") &gt;
          .table-page-table-wrap
            table.table-page-table
              thead
                tr
                  th {{t $.L "username"}}
                  th {{t $.L "status"}}
                  th {{t $.L "email-recovery-queued"}}
                  th {{t $.L "date"}}
                  th {{t $.L "actions"}}
              tbody
            p.quiet.table-page-empty(hidden) {{t $.L "email-recovery-empty"}}
        template.js-recovery-strings
          span(data-k="email-recovery-unavailable") {{t $.L "email-recovery-unavailable"}}
          span(data-k="email-recovery-queued") {{t $.L "email-recovery-queued"}}
          span(data-k="email-recovery-retrying") {{t $.L "email-recovery-retrying"}}
          span(data-k="email-recovery-stopped") {{t $.L "email-recovery-stopped"}}
          span(data-k="email-recovery-attempts") {{t $.L "email-recovery-attempts"}}
          span(data-k="email-recovery-oldest") {{t $.L "email-recovery-oldest"}}
          span(data-k="email-recovery-next") {{t $.L "email-recovery-next"}}
          span(data-k="email-recovery-changed") {{t $.L "email-recovery-changed"}}
          span(data-k="email-recovery-pause") {{t $.L "email-recovery-pause"}}
          span(data-k="email-recovery-resume") {{t $.L "email-recovery-resume"}}
          span(data-k="email-recovery-cancel") {{t $.L "email-recovery-cancel"}}
          span(data-k="email-recovery-retry") {{t $.L "email-recovery-retry"}}
          span(data-k="email-recovery-paused") {{t $.L "email-recovery-paused"}}
          span(data-k="email-recovery-pending") {{t $.L "email-recovery-pending"}}
          span(data-k="email-recovery-attention") {{t $.L "email-recovery-attention"}}
          span(data-k="email-recovery-busy") {{t $.L "email-recovery-busy"}}
          span(data-k="email-recovery-failed") {{t $.L "email-recovery-failed"}}
          span(data-k="email-recovery-superseded") {{t $.L "email-recovery-superseded"}}
          span(data-k="email-recovery-confirm-cancel") {{t $.L "email-recovery-confirm-cancel"}}
          span(data-k="email-failure-smtp-temporary") {{t $.L "email-failure-smtp-temporary"}}
          span(data-k="email-failure-smtp-rejected") {{t $.L "email-failure-smtp-rejected"}}
          span(data-k="email-failure-smtp-authentication") {{t $.L "email-failure-smtp-authentication"}}
          span(data-k="email-failure-smtp-configuration") {{t $.L "email-failure-smtp-configuration"}}
          span(data-k="email-failure-recipient-unavailable") {{t $.L "email-failure-recipient-unavailable"}}
          span(data-k="email-failure-delivery-unconfirmed") {{t $.L "email-failure-delivery-unconfirmed"}}
          span(data-k="email-failure-acknowledgement-failed") {{t $.L "email-failure-acknowledgement-failed"}}
          span(data-k="email-failure-delivery-failed") {{t $.L "email-failure-delivery-failed"}}
          span(data-k="email-failure-retry-limit") {{t $.L "email-failure-retry-limit"}}
      section.activity-notification-recovery-reports
        h2 {{t $.L "activity-recovery-heading"}}
        p.quiet {{t $.L "activity-recovery-description"}}
        p.error.js-recovery-error(role="alert", hidden)
        p.quiet.js-recovery-busy(hidden) {{t $.L "activity-recovery-retrying"}}
        .table-page
          .table-page-controls
            input.js-table-page-search(type="search", placeholder="{{t $.L `search`}}", aria-label="{{t $.L `search`}}")
            button.js-table-page-action(data-action="refresh-activity-notifications") {{t $.L "refresh"}}
            button.js-table-page-action(data-action="retry-all-activity-notifications") {{t $.L "activity-recovery-retry-all"}}
            button.js-table-page-action(data-action="cancel-old-activity-notifications") {{t $.L "activity-recovery-cancel-older"}}
            span.table-page-total
            .table-page-pagination
              button.js-table-page-prev(title="{{t $.L `previous`}}") &lt;
              span.table-page-page-info 1 / 1
              button.js-table-page-next(title="{{t $.L `next`}}") &gt;
          .table-page-table-wrap
            table.table-page-table
              thead
                tr
                  th {{t $.L "activity"}}
                  th {{t $.L "board"}}
                  th {{t $.L "status"}}
                  th {{t $.L "date"}}
                  th {{t $.L "actions"}}
              tbody
            p.quiet.table-page-empty(hidden) {{t $.L "activity-recovery-empty"}}
        template.js-recovery-strings
          span(data-k="card") {{t $.L "card"}}
          span(data-k="activity-recovery-unavailable") {{t $.L "activity-recovery-unavailable"}}
          span(data-k="activity-recovery-retry") {{t $.L "activity-recovery-retry"}}
          span(data-k="activity-recovery-pause") {{t $.L "activity-recovery-pause"}}
          span(data-k="activity-recovery-resume") {{t $.L "activity-recovery-resume"}}
          span(data-k="activity-recovery-paused") {{t $.L "activity-recovery-paused"}}
          span(data-k="activity-recovery-cancel") {{t $.L "activity-recovery-cancel"}}
          span(data-k="activity-recovery-cancel-confirm") {{t $.L "activity-recovery-cancel-confirm"}}
          span(data-k="activity-recovery-cancel-older-prompt") {{t $.L "activity-recovery-cancel-older-prompt"}}
          span(data-k="activity-recovery-bulk-result") {{t $.L "activity-recovery-bulk-result"}}
          span(data-k="activity-recovery-busy") {{t $.L "activity-recovery-busy"}}
          span(data-k="activity-recovery-denied") {{t $.L "activity-recovery-denied"}}
          span(data-k="activity-recovery-source-unavailable") {{t $.L "activity-recovery-source-unavailable"}}
          span(data-k="activity-recovery-disabled") {{t $.L "activity-recovery-disabled"}}
          span(data-k="activity-recovery-failed") {{t $.L "activity-recovery-failed"}}
          span(data-k="activity-recovery-control-conflict") {{t $.L "activity-recovery-control-conflict"}}
          span(data-k="activity-recovery-control-failed") {{t $.L "activity-recovery-control-failed"}}
          span(data-k="activity-recovery-status-pending") {{t $.L "activity-recovery-status-pending"}}
          span(data-k="activity-recovery-status-preparing") {{t $.L "activity-recovery-status-preparing"}}
          span(data-k="activity-recovery-status-processing") {{t $.L "activity-recovery-status-processing"}}
          span(data-k="activity-recovery-status-missing") {{t $.L "activity-recovery-status-missing"}}
          span(data-k="activity-recovery-status-changed") {{t $.L "activity-recovery-status-changed"}}
          span(data-k="activity-recovery-status-invalid") {{t $.L "activity-recovery-status-invalid"}}
          span(data-k="activity-recovery-status-inconsistent") {{t $.L "activity-recovery-status-inconsistent"}}
          span(data-k="activity-recovery-status-cancelled") {{t $.L "activity-recovery-status-cancelled"}}
