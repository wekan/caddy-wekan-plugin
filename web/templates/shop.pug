.wrapper
  .website-view.shop-view
    header.website-header
      h1
        a(href="{{.Home}}") {{.Title}}
      a.board-header-btn.js-toggle-board-view(href="#", title="{{t $.L `board-view-shop`}}")
        i.fa.fa-shopping-cart
        span.board-header-btn-label {{t $.L "board-view-shop"}}
      | {{template "_boardviews" .}}
      if .SettingsURL
        a(href="{{.SettingsURL}}") {{t $.L "settings"}}
    main.website-main
      if .Enabled
        if .Intro
          .viewer {{.Intro}}
        if .Categories
          nav.website-nav(aria-label="{{t $.L `shop-all-categories`}}")
            a(href="{{.Home}}") {{t $.L "shop-all-categories"}}
            each category in .Categories
              a(href="{{.URL}}") {{.Name}}
        p
          a(href="{{.CartURL}}") {{t $.L "shop-cart"}}
        if .CheckoutReview
          section.shop-checkout-review
            h2 {{t $.L "shop-checkout"}}
            ul
              each line in .CartLines
                li {{.Title}} · {{.Quantity}} × {{.Unit}} · {{.Total}}
            if .TaxVAT
              p {{t $.L "billing-amount"}} {{.TaxNet}}
              p {{t $.L "billing-vat"}} {{.TaxVAT}}
            p.shop-price {{t $.L "billing-total"}} {{.CartTotal}}
            if .TermsURL
              p
                a(href="{{.TermsURL}}", rel="noopener noreferrer") {{t $.L "shop-terms-url"}}
            if .OrderAction
              form(method="post", action="{{.OrderAction}}")
                input(type="hidden", name="id", value="{{.OrderID}}")
                input(type="hidden", name="quote", value="{{.Quote}}")
                p
                  label
                    | {{t $.L "name"}}
                    input(type="text", name="name", maxlength="100", required)
                p
                  label
                    | {{t $.L "email"}}
                    input(type="email", name="email", maxlength="254", required)
                p
                  label
                    | {{t $.L "billing-phone"}}
                    input(type="tel", name="phone", maxlength="40", autocomplete="tel")
                p
                  label
                    | {{t $.L "billing-address"}}
                    textarea(name="address", maxlength="500", rows="3", autocomplete="street-address")
                p
                  label
                    | {{t $.L "shop-note"}}
                    textarea(name="note", maxlength="1000", rows="3")
                if .TermsURL
                  label
                    input(type="checkbox", name="acceptTerms", value="1", required)
                    |  {{t $.L "shop-accept-terms"}}
                p
                  button(type="submit") {{t $.L "shop-place-order"}}

            a(href="{{.CartURL}}") {{t $.L "shop-cart"}}
        else if .Cart
          if .CartLines
            ul
              each line in .CartLines
                li
                  if .Unavailable
                    p {{t $.L "shop-sold-out"}}
                  if .Title
                    strong {{.Title}}
                    p {{.Unit}} {{.Total}}
                  form(method="post", action="{{$.CartAction}}")
                    input(type="hidden", name="product", value="{{.ID}}")
                    label
                      | {{t $.L "shop-quantity"}}
                      input(type="number", name="quantity", min="0", max="999", value="{{.Quantity}}", required)
                    button(type="submit") {{t $.L "save"}}
                  form(method="post", action="{{$.CartAction}}")
                    input(type="hidden", name="product", value="{{.ID}}")
                    input(type="hidden", name="quantity", value="0")
                    button(type="submit") {{t $.L "delete"}}
            if .TaxVAT
              p {{t $.L "billing-amount"}} {{.TaxNet}}
              p {{t $.L "billing-vat"}} {{.TaxVAT}}
            p.shop-price {{t $.L "billing-total"}} {{.CartTotal}}
          else
            p {{t $.L "shop-cart-empty"}}
          if .CheckoutURL
            p
              a(href="{{.CheckoutURL}}") {{t $.L "shop-checkout"}}
          else if .CheckoutLogin
            p
              a(href="/sign-in") {{t $.L "shop-login-to-order"}}
          a(href="{{.Home}}") {{t $.L "shop-continue"}}
        else if .Product
          article.shop-product
            h2 {{.Product.Title}}
            if .Product.Image
              img(src="{{.Product.Image}}", alt="{{.Product.Title}}")
            p.shop-price {{.Product.Price}}
            if .Product.SKU
              p {{.Product.SKU}}
            if .Product.SoldOut
              p {{t $.L "shop-sold-out"}}
            else
              form(method="post", action="{{$.CartAction}}")
                input(type="hidden", name="product", value="{{.Product.ID}}")
                input(type="hidden", name="add", value="1")
                label
                  | {{t $.L "shop-quantity"}}
                  input(type="number", name="quantity", min="1", max="{{.Product.Stock}}", value="1", required)
                button(type="submit") {{t $.L "shop-add-to-cart"}}
            .viewer {{.Description}}
        else if .Products
          .shop-products
            each product in .Products
              article.shop-product
                if .Image
                  img(src="{{.Image}}", alt="", loading="lazy")
                h2
                  a(href="{{.URL}}") {{.Title}}
                p.shop-price {{.Price}}
                if .SoldOut
                  p {{t $.L "shop-sold-out"}}
        else
          p {{t $.L "shop-empty"}}
      else
        p {{t $.L "shop-closed"}}
