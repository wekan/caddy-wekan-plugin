.board-list-wrapper
  h1.board-list-title {{t $.L "all-boards"}}
  //- WeKan's All Boards sections, each with its count.
  ul.board-list-menu.js-board-sections
    each sec in .Sections
      li.menu-item(class="{{if eq .Type $.Section}}active{{end}}")
        a.js-select-menu(href="/allboards/{{.Type}}", data-type="{{.Type}}")
          span.menu-label
            i.fa(class="{{.Icon}}")
            |  {{t $.L .Label}}
          span.menu-count {{.Count}}
  ul.board-list.js-boards
    each b in .Boards
      li.js-board(data-id="{{.ID}}", class="{{.ID}}{{if starred $.User .ID}} starred{{end}}")
        a.board-list-item(href="/b/{{.ID}}/{{.Slug}}", class="board-color-{{.Color}}", up-follow)
          span.board-list-item-name {{.Title}}
    li.js-add-board
      form.js-add-board-form(method="post", action="/boards", up-submit)
        input.js-new-board-title(type="text", name="title", aria-label="{{t $.L `title`}}", placeholder="{{t $.L `title`}}", required)
        button.primary(type="submit") {{t $.L "add-board"}}
