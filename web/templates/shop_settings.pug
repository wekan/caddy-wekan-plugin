.wrapper
  main.website-view
    h1 {{t $.L "board-view-shop"}} · {{.Board.Title}}
    form(method="post")
      p
        label
          | <input type="checkbox" name="enabled" value="1" {{if eq .Settings.enabled true}}checked{{end}}>
          |  {{t $.L "shop-open"}}
      p
        label
          | {{t $.L "title"}}
          input(type="text", name="title", maxlength="200", value="{{.Settings.title}}")
      p
        label
          | {{t $.L "shop-intro"}}
          textarea(name="intro", maxlength="5000", rows="4") {{.Settings.intro}}
      p
        label
          | {{t $.L "billing-currency"}}
          input(type="text", name="currency", maxlength="3", pattern="[A-Za-z]{3}", value="{{.Currency}}", required)
      p
        label
          | {{t $.L "billing-vat"}} (%)
          input(type="number", name="vatPercent", min="0", max="100", step="0.01", value="{{.VATPercent}}", required)
      p
        label
          | <input type="checkbox" name="pricesIncludeVat" value="1" {{if .PricesIncludeVAT}}checked{{end}}>
          |  {{t $.L "shop-prices-include-vat"}}

      each picker in .Pickers
        p
          label
            | {{t $.L .Label}}
            select(name="{{.Key}}")
              option(value="") {{t $.L "shop-not-chosen"}}
              each option in .Options
                | <option value="{{.ID}}" {{if .Selected}}selected{{end}}> {{.Name}}</option>
      fieldset
        legend {{t $.L "shop-sale-lists"}}
        each list in .Lists
          label
            | <input type="checkbox" name="saleListIds" value="{{.ID}}" {{if .Selected}}checked{{end}}>
            |  {{.Name}}
      fieldset
        legend {{t $.L "shop-category-labels"}}
        each label in .Labels
          label
            | <input type="checkbox" name="categoryLabelIds" value="{{.ID}}" {{if .Selected}}checked{{end}}>
            |  {{.Name}}
      fieldset
        legend {{t $.L "shop-orders-list"}}
        p {{t $.L "shop-orders-private"}}
        select(name="ordersListId", aria-label="{{t $.L `shop-orders-list`}}")
          option(value="") {{t $.L "shop-not-chosen"}}
          each destination in .OrderLists
            | <option value="{{.ID}}" {{if .Selected}}selected{{end}}>{{.Name}}</option>
        p
          label
            | <input type="checkbox" name="guestCheckout" value="1" {{if eq .Settings.guestCheckout true}}checked{{end}}>
            |  {{t $.L "shop-guest-checkout"}}
        p
          label
            | <input type="checkbox" name="decrementStock" value="1" {{if .DecrementStock}}checked{{end}}>
            |  {{t $.L "shop-decrement-stock"}}
        p
          label
            | <input type="checkbox" name="confirmationEmail" value="1" {{if .ConfirmationEmail}}checked{{end}}>
            |  {{t $.L "shop-confirmation-email"}}
        p
          label
            | {{t $.L "shop-terms-url"}}
            input(type="url", name="termsUrl", maxlength="2000", value="{{.Settings.termsUrl}}")

      p
        label
          | {{t $.L "billing-reference"}}
          select(name="referenceType")
            each option in .References
              | <option value="{{.ID}}" {{if .Selected}}selected{{end}}>{{t $.L .Name}}</option>
      p
        label
          | {{t $.L "billing-method-link"}}
          input(type="text", name="paymentLink", maxlength="2000", value="{{.PaymentLink}}")
      each method in .ManualMethods
        fieldset
          legend {{t $.L .Label}}
          if eq .Field "bankDetails"
            p
              label
                | {{t $.L "name"}}
                input(type="text", name="bankName", maxlength="200", value="{{.Name}}")
          p
            label
              | {{t $.L "billing-field-details"}}
              textarea(name="{{.Field}}", maxlength="2000", rows="4") {{.Details}}
      p
        label
          | <input type="checkbox" name="publicDefault" value="1" {{if .PublicDefault}}checked{{end}}>
          |  {{t $.L "shop-show-on-public"}}
      button(type="submit") {{t $.L "save"}}
      a(href="{{.Shop}}") {{t $.L "cancel"}}
