//- WeKan's Admin Panel / Problems / Password length (passwordLengthReport.jade):
  the minimum, whether it is enforced - saved as Admin Panel's login settings,
  over the environment - and who signs in with a shorter password, a row an
  account, newest first, by filter and search, ten a page.
.setting-content.admin-reports-content
  .content-body
    .side-menu
      ul
        li
          a.js-left-menu-item(href="/admin/problems/security-report", data-id="report-security")
            i.fa.fa-shield
            |  {{t $.L "securityReportTitle"}}
        li
          a.js-left-menu-item(href="/admin/problems/recovery", data-id="report-recovery") {{t $.L "recoveryReportTitle"}}
        li.active
          a.js-left-menu-item(href="/admin/problems/password-length", data-id="report-password-length")
            i.fa.fa-key
            |  {{t $.L "password-length-report-title"}}
    .main-body
      h2.pane-title {{t $.L "password-length-report-title"}}
      form.js-password-length-settings(method="post", action="/admin/problems/password-length")
        ul.setting-detail.password-length-settings
          li
            label(for="password-min-length-input") {{t $.L "password-min-length"}}
            input#password-min-length-input.js-password-min-length(type="number", name="minLength", min="1", max="256", value="{{.MinLength}}")
            p.description {{t $.L "password-min-length-description"}}
          li
            //- WeKan's toggle: its square, the value sent with the form.
            a.flex.js-toggle-password-min-length-enforce(href="#", role="checkbox", aria-checked="{{if .Enforce}}true{{else}}false{{end}}")
              .materialCheckBox(class="{{if .Enforce}}is-checked{{end}}")
              span {{t $.L "password-min-length-enforce"}}
            input.js-password-min-length-enforce(type="hidden", name="enforce", value="{{if .Enforce}}true{{end}}")
            p.description {{t $.L "password-min-length-enforce-description"}}
          li
            button.primary.js-save-password-length(type="submit") {{t $.L "save"}}
            if .Saved
              span.password-length-saved {{t $.L "password-length-saved"}}
            if .SaveError
              p.error.password-length-error {{.SaveError}}
            if .FromEnvironment
              p.description {{t $.L "password-length-from-environment"}}
      section.password-length-report
        p.quiet {{t $.L "password-length-report-desc"}}
        form.table-page-controls(method="get", action="/admin/problems/password-length")
          input.js-table-page-search(type="search", name="q", value="{{.Search}}", placeholder="{{t $.L `search`}}", aria-label="{{t $.L `search`}}")
          select.js-table-page-filter#password-length-status(name="filter", data-filter="password-length-status", aria-label="{{t $.L `status`}}")
            each o in .Filters
              if eq .Value $.Filter
                option(value="{{.Value}}", selected) {{.Label}}
              else
                option(value="{{.Value}}") {{.Label}}
          button(type="submit") {{t $.L "search"}}
          span.table-page-total {{.Total}}
          .table-page-pagination
            if .Prev
              a.js-table-page-prev(href="{{.Prev}}", title="{{t $.L `previous`}}") &lt;
            span.table-page-page-info {{.Page}} / {{.Pages}}
            if .Next
              a.js-table-page-next(href="{{.Next}}", title="{{t $.L `next`}}") &gt;
        if .Rows
          .table-page-table-wrap
            table.table-page-table.password-length-table
              thead
                tr
                  th {{t $.L "username"}}
                  th {{t $.L "password-length-first-login"}}
                  th {{t $.L "password-length-last-login"}}
                  th {{t $.L "password-length-login-count"}}
                  th {{t $.L "password-length-fixed"}}
                  th {{t $.L "event-ipv4"}}
                  th {{t $.L "event-ipv6"}}
              tbody
                each row in .Rows
                  tr.js-password-length-row
                    td {{.Username}}
                    td.nowrap {{.First}}
                    td.nowrap {{.Last}}
                    td.align-end {{.Count}}
                    td.nowrap {{.Fixed}}
                    td {{.IPv4}}
                    td {{.IPv6}}
        else
          p.table-page-empty {{t $.L "password-length-no-results"}}
