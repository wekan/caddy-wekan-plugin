                    button.primary(type="submit") {{t $.L "add-card"}}
                    a.js-close-inlined-form(href="#", aria-label="{{t $.L `close`}}") ×
          if $.CanEdit
            .list.js-list-composer
              form.js-inlined-form.js-list-form(method="post", action="/b/{{$.Board.ID}}/lists", up-submit, up-target=".board-wrapper")
                input.list-name-input(type="text", name="title", aria-label="{{t $.L `add-list`}}", placeholder="{{t $.L `add-list`}}", required)
                button.primary(type="submit") {{t $.L "add-list"}}
  if .Card
    .card-details.js-card-details(data-card="{{.Card.ID}}", class="{{if .User.Profile.CardMaximized}}card-details-maximized{{end}}")
      .card-details-header
        //- WeKan's card title: its leading part opens the editor (Ctrl+Enter saves).
        h2.card-details-title.js-card-title
          if .CanEdit
            span.card-details-title-edit-zone.js-open-inlined-form {{viewer .Card.Title $.TextPolicy}}
          else
            | {{viewer .Card.Title $.TextPolicy}}
        if .CanEdit
          form.js-card-details-title.js-inlined-form.is-hidden(method="post", action="/b/{{.Board.ID}}/cards/{{.Card.ID}}/title", up-submit, up-target=".board-wrapper")
            textarea(name="title", rows="2", dir="auto", aria-label="{{t $.L `title`}}", required) {{.Card.Title}}
            button.primary(type="submit") {{t $.L "save"}}
        if .User.Profile.CardMaximized
          a.js-minimize-card-details(href="#", title="{{t $.L `minimize-card`}}", aria-label="{{t $.L `minimize-card`}}") 🗗
        else
          a.js-maximize-card-details(href="#", title="{{t $.L `maximize-card`}}", aria-label="{{t $.L `maximize-card`}}") 🗖
        if .CanEdit
          a.card-details-menu.js-open-card-details-menu(href="#", title="{{t $.L `cardDetailsActionsPopup-title`}}", aria-label="{{t $.L `cardDetailsActionsPopup-title`}}") ☰
        a.js-close-card-details(href="/b/{{.Board.ID}}/{{.Board.Slug}}", aria-label="{{t $.L `close`}}", up-follow, up-target=".board-wrapper") ×
      a.js-toggle-watch-card(href="/b/{{.Board.ID}}/cards/{{.Card.ID}}/watch", up-method="post", up-target=".board-wrapper", class="{{if .WatchingCard}}is-checked{{end}}") {{if .WatchingCard}}{{t $.L "watching"}} ✓{{else}}{{t $.L "watch"}}{{end}}
      .card-details-items
        .card-details-item.card-details-item-members
          h3.card-details-item-title {{t $.L "members"}}
          each mem in .CardMembers
            span.card-member.js-member(data-user="{{.ID}}") {{.Username}}
          if $.CanEdit
            a.card-details-item-add-button.js-add-members(href="#", title="{{t $.L `add-members`}}", aria-label="{{t $.L `add-members`}}") +
        //- WeKan's card list picker: the card's list, and another of the board.
        .card-details-item.card-details-item-list
          h3.card-details-item-title {{t $.L "list"}}
          if $.CanEdit
            details.card-details-list-picker
              summary
                each li in $.Lists
                  if eq .ID $.Card.ListID
                    | {{.Title}}
              .card-details-list-options(role="listbox", aria-label="{{t $.L `list`}}")
                each li in $.Lists
                  form(method="post", action="/b/{{$.Board.ID}}/cards/{{$.Card.ID}}/move-to", up-submit, up-target=".board-wrapper")
                    input(type="hidden", name="boardId", value="{{$.Board.ID}}")
                    input(type="hidden", name="swimlaneId", value="{{$.Card.SwimlaneID}}")
                    input(type="hidden", name="listId", value="{{.ID}}")
                    button.js-select-card-details-list-option(type="submit", role="option", data-list-id="{{.ID}}", aria-selected="{{if eq .ID $.Card.ListID}}true{{else}}false{{end}}") {{.Title}}
          else
            each li in $.Lists
              if eq .ID $.Card.ListID
                span {{.Title}}
        //- WeKan's card labels, and the + that opens cardLabelsPopup.
        .card-details-item.card-details-item-labels
          h3.card-details-item-title {{t $.L "labels"}}
          each lb in .CardLabels
            if .Selected
              span.card-label(class="card-label-{{.Color}}") {{.Name}}
          if $.CanEdit
            a.card-details-item-add-button.js-add-labels(href="#", title="{{t $.L `cardLabelsPopup-title`}}", aria-label="{{t $.L `cardLabelsPopup-title`}}") +
        //- WeKan's cardButtons: the board's card button rules.
        if .CardButtons
          .card-details-item.card-details-item-buttons
            h3.card-details-item-title
              i.fa.fa-hand-pointer-o
              |  {{t $.L "r-card-button"}}
            .card-details-item-content.card-buttons
              each btn in .CardButtons
                button.primary.js-run-card-button(type="button", data-rule-id="{{.ID}}")
                  i.fa.fa-magic
                  |  {{.Label}}
        //- WeKan's Requested By and Assigned By: free text, Edit or Add.
        each p in .People
          .card-details-item.card-details-item-name(class="card-details-item-{{.Label}}")
            h3.card-details-item-title
              i.fa(class="{{.Icon}}")
              |  {{t $.L .Label}}
            if .Value
              .viewer {{.Value}}
            if .Editable
              .card-details-person-controls
                if .Value
                  a.js-open-inlined-form(href="#", title="{{t $.L `edit`}}", aria-label="{{t $.L `edit`}}")
                    i.fa.fa-pencil-square-o(aria-hidden="true")
                else
                  a.js-open-inlined-form(href="#", title="{{t $.L `add`}}", aria-label="{{t $.L `add`}}")
                    i.fa.fa-plus(aria-hidden="true")
              form.js-inlined-form.is-hidden(method="post", action="/b/{{$.Board.ID}}/cards/{{$.Card.ID}}/people", up-submit, up-target=".board-wrapper")
                input(type="hidden", name="field", value="{{.Field}}")
                input(type="text", name="value", value="{{.Value}}", aria-label="{{t $.L .Label}}")
                button.primary(type="submit") {{t $.L "save"}}
                a.js-close-inlined-form(href="#", aria-label="{{t $.L `close`}}") ×
      if .Vote
        .card-details-group.card-details-group-vote
          h3.card-details-item-title.js-toggle-card-section(data-section="vote", role="button", tabindex="0")
