.board-wrapper(class="board-color-{{.Board.Color}}", data-board="{{.Board.ID}}", data-live="/b/{{.Board.ID}}/live", data-move="/b/{{.Board.ID}}/move")
  .board-header
    h1.header-board-name.js-board-title {{.Board.Title}}
    //- WeKan's boardStarButton: the user's favorite, kept in their profile.
    if .Starred
      a.board-header-btn.js-star-board.is-active(href="#", title="{{t $.L `click-to-unstar`}}", data-star="{{t $.L `click-to-star`}}", data-unstar="{{t $.L `click-to-unstar`}}")
        i.fa.fa-star
    else
      a.board-header-btn.js-star-board(href="#", title="{{t $.L `click-to-star`}}", data-star="{{t $.L `click-to-star`}}", data-unstar="{{t $.L `click-to-unstar`}}")
        i.fa.fa-star-o
    //- WeKan's boardButtons: the board's button rules.
    each btn in .BoardButtons
      a.board-header-btn.js-run-board-button(href="#", data-rule-id="{{.ID}}", title="{{.Label}}")
        i.fa.fa-magic
        span {{.Label}}
    a.board-header-btn.js-watch-board(href="#", title="{{t $.L .WatchLevel}}")
      span.board-header-btn-label {{t $.L .WatchLevel}}
    a.board-header-btn.js-toggle-page-sidebar(href="#", title="{{t $.L `sidebar-open`}}", aria-label="{{t $.L `sidebar-open`}}") ☰
  .board-sidebar.sidebar
    a.sidebar-xmark.js-close-sidebar(href="#", aria-label="{{t $.L `close`}}") ✕
    .sidebar-content.js-board-sidebar-content
      if .Invited
        //- sidebar.jade: an invitation to this board, to accept or decline.
        .js-board-invitation
          p
            i.fa.fa-exclamation-triangle
            |  {{t $.L "just-invited"}}
          button.js-member-invite-accept.primary(type="button") {{t $.L "accept"}}
          button.js-member-invite-decline(type="button") {{t $.L "decline"}}
        hr
      if .MenuOn
        h3
          a.board-header-btn.js-open-board-menu(href="#", title="{{t $.L `boardMenuPopup-title`}}") {{t $.L "boardMenuPopup-title"}}
      if .Board.AdminOf .User.ID
        hr
        h3.activity-title.js-toggle-show-activities(role="button", tabindex="0", title="{{t $.L `activities`}}")
          i.fa.fa-caret-right
          i.fa.fa-comment-o
          |  {{t $.L "activities"}}
        .activities.js-sidebar-activities.is-hidden
          each act in .BoardActivities
            .activity(data-id="{{.ID}}")
              .activity-desc
                span.activity-member {{.User}}
                |  {{.Text}}
              time.activity-time(datetime="{{.ISO}}") {{.Display}}
  template.js-pop-over-template(data-pop="board-menu", data-title="{{t $.L `boardMenuPopup-title`}}")
    .header
      span.header-title {{t $.L "boardMenuPopup-title"}}
      a.close-btn.js-close-pop-over(href="#", aria-label="{{t $.L `close`}}") ×
    .content
      ul.pop-over-list
        if .CanExport
          li
            a.js-export-board(href="#") {{t $.L "export"}}
  if .CanEdit
    //- WeKan's swimlaneAddPopup: a swimlane below or above the chosen one.
    template.js-pop-over-template(data-pop="add-swimlane", data-title="{{t $.L `swimlaneAddPopup-title`}}")
      form.js-add-swimlane-form(method="post", action="/b/{{.Board.ID}}/swimlanes", up-submit, up-target=".board-wrapper")
        input.js-swimlane-after(type="hidden", name="after")
        textarea.swimlane-name-input.full-line(name="title", rows="2", dir="auto", placeholder="{{t $.L `add-swimlane`}}", aria-label="{{t $.L `add-swimlane`}}", autocomplete="off", required)
        label.swimlane-placement-option
          input.js-swimlane-placement(type="radio", name="placement", value="below", checked)
          span(dir="auto") {{t $.L "below-selected-swimlane"}}
        label.swimlane-placement-option
          input.js-swimlane-placement(type="radio", name="placement", value="above")
          span(dir="auto") {{t $.L "above-selected-swimlane"}}
        .edit-controls.clearfix
          button.primary.confirm(type="submit") {{t $.L "add"}}
  template.js-pop-over-template(data-pop="watch", data-title="{{t $.L `boardChangeWatchPopup-title`}}")
    .header
      span.header-title {{t $.L "boardChangeWatchPopup-title"}}
      a.close-btn.js-close-pop-over(href="#", aria-label="{{t $.L `close`}}") ×
    .content
      ul.pop-over-list.described-list
        li
          a.js-select-watch(href="/b/{{.Board.ID}}/watch?level=watching", up-method="post", up-target=".board-wrapper", data-level="watching") {{t $.L "watching"}}{{if eq .WatchLevel "watching"}} ✓{{end}}
          span.sub-name {{t $.L "watching-info"}}
        li
          a.js-select-watch(href="/b/{{.Board.ID}}/watch?level=tracking", up-method="post", up-target=".board-wrapper", data-level="tracking") {{t $.L "tracking"}}{{if eq .WatchLevel "tracking"}} ✓{{end}}
          span.sub-name {{t $.L "tracking-info"}}
        li
          a.js-select-watch(href="/b/{{.Board.ID}}/watch?level=muted", up-method="post", up-target=".board-wrapper", data-level="muted") {{t $.L "muted"}}{{if eq .WatchLevel "muted"}} ✓{{end}}
          span.sub-name {{t $.L "muted-info"}}
  if .Card
    template.js-pop-over-template(data-pop="card-members", data-title="{{t $.L `cardMembersPopup-title`}}")
      .header
        span.header-title {{t $.L "cardMembersPopup-title"}}
        a.close-btn.js-close-pop-over(href="#", aria-label="{{t $.L `close`}}") ×
      .content
        ul.pop-over-list.js-card-member-list
          each bm in .BoardMembers
            li
              form(method="post", action="/b/{{$.Board.ID}}/cards/{{$.Card.ID}}/members/{{.ID}}", up-submit, up-target=".board-wrapper")
                button.js-select-member(type="submit", class="{{if .Selected}}is-active{{end}}", data-user="{{.ID}}") {{.Username}}{{if .Fullname}} ({{.Fullname}}){{end}}{{if .Selected}} ✓{{end}}
  if .CanExport
    template.js-pop-over-template(data-pop="export", data-title="{{t $.L `export`}}")
      .header
        span.header-title {{t $.L "export"}}
        a.close-btn.js-close-pop-over(href="#", aria-label="{{t $.L `close`}}") ×
      .content
        .export-board-panes
          .export-board-pane.export-board-pane-formats
            h4.pop-over-list-subheading JSON
            ul.pop-over-list
              li
                a(href="/api/boards/{{.Board.ID}}/export", download) JSON
              li
                a(href="/api/boards/{{.Board.ID}}/export?attachments=false", download) JSON - {{t $.L "export-board-without-attachments"}}
              li
                a(href="/api/boards/{{.Board.ID}}/exportZip", download) .zip - {{t $.L "attachments"}}
            hr
            h4.pop-over-list-subheading CSV
            ul.pop-over-list
              li
                a(href="/api/boards/{{.Board.ID}}/export/csv?delimiter=%2C", download) (,)
              li
                a(href="/api/boards/{{.Board.ID}}/export/csv?delimiter=%3B", download) (;)
              li
                a(href="/api/boards/{{.Board.ID}}/export/csv?delimiter=%09", download) TSV
            hr
            h4.pop-over-list-subheading iCalendar
            ul.pop-over-list
              li
                a(href="/api/boards/{{.Board.ID}}/calendar.ics", download) .ics
  .board-canvas#board-canvas
    each sw in .Lanes
      .swimlane.js-swimlane(id="swimlane-{{.ID}}", data-swimlane="{{.ID}}")
        .swimlane-header.js-swimlane-header
          span.swimlane-header-name.title {{.Title}}
          if $.CanEdit
            a.js-open-add-swimlane-menu.swimlane-header-plus-icon(href="#", data-swimlane="{{.ID}}", title="{{t $.L `add-swimlane`}}", aria-label="{{t $.L `add-swimlane`}}")
              i.fa.fa-plus
        .list-group.js-lists
          each li in .Lists
            .list.js-list(id="js-list-{{.ID}}", data-list="{{.ID}}", data-swimlane="{{.Lane}}", class="{{if .Collapsed}}list-collapsed{{end}}")
              .list-header
                //- WeKan's caret (listHeader.jade): per user, per list in this swimlane (#6712).
                if .Collapsed
                  a.list-collapse-indicator.js-collapse(href="#", data-collapse="{{t $.L `collapse`}}", data-uncollapse="{{t $.L `uncollapse`}}", title="{{t $.L `uncollapse`}}", aria-label="{{t $.L `uncollapse`}}")
                    i.fa.fa-caret-right
                else
                  a.list-collapse-indicator.js-collapse(href="#", data-collapse="{{t $.L `collapse`}}", data-uncollapse="{{t $.L `uncollapse`}}", title="{{t $.L `collapse`}}", aria-label="{{t $.L `collapse`}}")
                    i.fa.fa-caret-down
                span.list-header-name {{.Title}}
                if $.CanEdit
                  a.js-add-card.list-header-plus-top(href="#", title="{{t $.L `add-card`}}", aria-label="{{t $.L `add-card`}}") +
              .list-body.js-minicards(data-list="{{.ID}}", data-swimlane="{{.Lane}}")
                each c in .Cards
                  a.minicard-wrapper.js-minicard(href="/b/{{$.Board.ID}}/{{$.Board.Slug}}/{{.ID}}", data-card="{{.ID}}", data-sort="{{.Sort}}", up-follow, up-target=".board-wrapper")
                    .minicard
                      .minicard-title {{.Title}}
              if $.CanEdit
                form.js-inlined-form.js-card-composer.is-hidden(method="post", action="/b/{{$.Board.ID}}/cards", up-submit, up-target=".board-wrapper")
                  input(type="hidden", name="listId", value="{{.ID}}")
                  input(type="hidden", name="swimlaneId", value="{{.Lane}}")
                  textarea.js-card-title(name="title", aria-label="{{t $.L `title`}}", required)
                  button.primary(type="submit") {{t $.L "add-card"}}
                  a.js-close-inlined-form(href="#", aria-label="{{t $.L `close`}}") ×
          if $.CanEdit
            .list.js-list-composer
              form.js-inlined-form.js-list-form(method="post", action="/b/{{$.Board.ID}}/lists", up-submit, up-target=".board-wrapper")
                input.list-name-input(type="text", name="title", aria-label="{{t $.L `add-list`}}", placeholder="{{t $.L `add-list`}}", required)
                button.primary(type="submit") {{t $.L "add-list"}}
  if .Card
    .card-details.js-card-details(data-card="{{.Card.ID}}")
      .card-details-header
        h2.card-details-title.js-card-title {{.Card.Title}}
        a.js-close-card-details(href="/b/{{.Board.ID}}/{{.Board.Slug}}", aria-label="{{t $.L `close`}}", up-follow, up-target=".board-wrapper") ×
      a.js-toggle-watch-card(href="/b/{{.Board.ID}}/cards/{{.Card.ID}}/watch", up-method="post", up-target=".board-wrapper", class="{{if .WatchingCard}}is-checked{{end}}") {{if .WatchingCard}}{{t $.L "watching"}} ✓{{else}}{{t $.L "watch"}}{{end}}
      .card-details-items
        .card-details-item.card-details-item-members
          h3.card-details-item-title {{t $.L "members"}}
          each mem in .CardMembers
            span.card-member.js-member(data-user="{{.ID}}") {{.Username}}
          if $.CanEdit
            a.card-details-item-add-button.js-add-members(href="#", title="{{t $.L `add-members`}}", aria-label="{{t $.L `add-members`}}") +
        //- WeKan's cardButtons: the board's card button rules.
        if .CardButtons
          .card-details-item.card-details-item-buttons
            h3.card-details-item-title
              i.fa.fa-hand-pointer-o
              |  {{t $.L "r-card-button"}}
            .card-details-item-content.card-buttons
              each btn in .CardButtons
                button.primary.js-run-card-button(type="button", data-rule-id="{{.ID}}")
                  i.fa.fa-magic
                  |  {{.Label}}
        //- WeKan's Requested By and Assigned By: free text, Edit or Add.
        each p in .People
          .card-details-item.card-details-item-name(class="card-details-item-{{.Label}}")
            h3.card-details-item-title
              i.fa(class="{{.Icon}}")
              |  {{t $.L .Label}}
            if .Value
              .viewer {{.Value}}
            if .Editable
              .card-details-person-controls
                if .Value
                  a.js-open-inlined-form(href="#", title="{{t $.L `edit`}}", aria-label="{{t $.L `edit`}}")
                    i.fa.fa-pencil-square-o(aria-hidden="true")
                else
                  a.js-open-inlined-form(href="#", title="{{t $.L `add`}}", aria-label="{{t $.L `add`}}")
                    i.fa.fa-plus(aria-hidden="true")
              form.js-inlined-form.is-hidden(method="post", action="/b/{{$.Board.ID}}/cards/{{$.Card.ID}}/people", up-submit, up-target=".board-wrapper")
                input(type="hidden", name="field", value="{{.Field}}")
                input(type="text", name="value", value="{{.Value}}", aria-label="{{t $.L .Label}}")
                button.primary(type="submit") {{t $.L "save"}}
                a.js-close-inlined-form(href="#", aria-label="{{t $.L `close`}}") ×
      if .Vote
        .card-details-group.card-details-group-vote
          h3.card-details-item-title.js-toggle-card-section(data-section="vote", role="button", tabindex="0")
            i.fa.fa-caret-down
            |  {{t $.L "vote-question"}}
          .card-details-section(data-section="vote")
            .vote-result
              if .Vote.Public
                a.card-label.card-label-green.js-show-positive-votes {{.Vote.Positive}}
                a.card-label.card-label-red.js-show-negative-votes {{.Vote.Negative}}
              else
                .card-label.card-label-green {{.Vote.Positive}}
                .card-label.card-label-red {{.Vote.Negative}}
            .viewer {{.Vote.Question}}
            if .Vote.CanVote
              form.js-vote-form(method="post", action="/b/{{.Board.ID}}/cards/{{.Card.ID}}/vote", up-submit, up-target=".board-wrapper")
                button.card-details-green.js-vote.js-vote-positive(type="submit", name="vote", value="positive", class="{{if .Vote.For}}voted{{end}}") {{t $.L "vote-for-it"}}
                button.card-details-red.js-vote.js-vote-negative(type="submit", name="vote", value="negative", class="{{if .Vote.Against}}voted{{end}}") {{t $.L "vote-against"}}
      if .Poker
        .card-details-group.card-details-group-poker
          h3.card-details-item-title.js-toggle-card-section(data-section="poker", role="button", tabindex="0")
            i.fa.fa-caret-down
            |  {{t $.L "poker-question"}}
          .card-details-section(data-section="poker")
            .viewer {{.Poker.Question}}
            if .Poker.CanVote
              form.poker-result(method="post", action="/b/{{.Board.ID}}/cards/{{.Card.ID}}/poker", up-submit, up-target=".board-wrapper")
                each pc in .Poker.Cards
                  .poker-deck
                    .poker-card
                      button.inner.js-poker(type="submit", name="state", value="{{.Field}}", class="js-poker-vote-{{.Class}}{{if .Voted}} poker-voted{{end}}") {{.Label}}
      h3 {{t $.L "description"}}
      .card-description.js-card-description {{.Card.Description}}
      h3 {{t $.L "attachments"}}
      ul.attachments.js-attachments
        each a in .Attachments
          li.js-attachment(data-attachment="{{.ID}}")
            a.attachment-name(href="/cdn/storage/attachments/{{.ID}}/original/{{.Name}}", target="_blank", rel="noopener") {{.Name}}
            if $.CanEdit
              form.js-attachment-delete(method="post", action="/attachments/{{.ID}}/delete", up-submit, up-target=".board-wrapper")
                button(type="submit", aria-label="{{t $.L `delete`}}") ×
      h3.card-details-item-title {{t $.L "comments"}}
      .comments
        if .CanComment
          .new-comment.js-new-comment
            form.js-new-comment-form(method="post", action="/b/{{.Board.ID}}/cards/{{.Card.ID}}/comments", up-submit, up-target=".board-wrapper")
              textarea.editor.js-new-comment-input(name="comment", aria-label="{{t $.L `comment`}}", required)
              button.primary.confirm.js-add-comment(type="submit") {{t $.L "comment"}}
        each cm in .Comments
          .comment(data-id="{{.ID}}")
            span.comment-member {{.User}}
            .comment-text
              .viewer {{.Text}}
            time.activity-time(datetime="{{.ISO}}") {{.Display}}
      h3.card-details-item-title.js-toggle-card-section(data-section="activities", role="button", tabindex="0")
        i.fa.fa-caret-right
        |  {{t $.L "activities"}}
      .card-details-section.js-card-section.is-hidden(data-section="activities")
        .activities.js-card-activities
          each act in .CardActivities
            .activity(data-id="{{.ID}}")
              .activity-desc
                span.activity-member {{.User}}
                |  {{.Text}}
              time.activity-time(datetime="{{.ISO}}") {{.Display}}
      if .CanEdit
        form.js-attachment-upload(method="post", action="/b/{{.Board.ID}}/cards/{{.Card.ID}}/attachments", enctype="multipart/form-data")
          input(type="file", name="file", aria-label="{{t $.L `add-attachment`}}", required)
          button.primary(type="submit") {{t $.L "add-attachment"}}
