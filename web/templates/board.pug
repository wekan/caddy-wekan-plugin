.board-wrapper(class="board-color-{{.Board.Color}}", style="{{.Board.BackgroundStyle}}", data-board="{{.Board.ID}}", data-live="/b/{{.Board.ID}}/live?v={{.BoardStamp}}", data-move="/b/{{.Board.ID}}/move", data-submit-on-enter="{{if .User}}{{if .User.Profile.SubmitOnEnter}}true{{end}}{{end}}")
  .board-header
    h1.header-board-name.js-board-title {{.Board.Title}}
    //- WeKan's boardStarButton: the user's favorite, kept in their profile.
    if .Starred
      a.board-header-btn.js-star-board.is-active(href="#", title="{{t $.L `click-to-unstar`}}", data-star="{{t $.L `click-to-star`}}", data-unstar="{{t $.L `click-to-unstar`}}")
        i.fa.fa-star
    else
      a.board-header-btn.js-star-board(href="#", title="{{t $.L `click-to-star`}}", data-star="{{t $.L `click-to-star`}}", data-unstar="{{t $.L `click-to-unstar`}}")
        i.fa.fa-star-o
    //- WeKan's boardButtons: the board's button rules.
    each btn in .BoardButtons
      a.board-header-btn.js-run-board-button(href="#", data-rule-id="{{.ID}}", title="{{.Label}}")
        i.fa.fa-magic
        span {{.Label}}
    //- WeKan's visibility button: a board admin changes it.
    if .IsBoardAdmin
      a.board-header-btn.js-change-visibility(href="#", title="{{t $.L .Board.Permission}}")
        i.fa(class="{{visibilityIcon .Board.Permission}}")
        span.board-header-btn-label {{t $.L .Board.Permission}}
    //- WeKan's Multi-Selection: select cards, then act on all of them.
    if .CanEdit
      a.board-header-btn.js-multiselection-activate(href="#", title="{{t $.L `multi-selection`}}", aria-label="{{t $.L `multi-selection`}}") ☑
    //- WeKan's Board View button: the swimlanes, or a Scrum view.
    a.board-header-btn.js-toggle-board-view(href="#", title="{{t $.L `swimlanes`}}")
      i.fa.fa-th-large
      span.board-header-btn-label {{t $.L "swimlanes"}}
    a.board-header-btn.js-watch-board(href="#", title="{{t $.L .WatchLevel}}")
      span.board-header-btn-label {{t $.L .WatchLevel}}
    //- WeKan's boardHeader: the Filter, on while a filter is.
    if .FilterActive
      a.board-header-btn.js-open-filter-view.js-filter-active(href="#", title="{{t $.L `filter-on-desc`}}")
        i.fa.fa-filter
        span.board-header-btn-label {{t $.L "filter-on-desc"}}
      a.board-header-btn-close.js-filter-reset(href="#", title="{{t $.L `filter-clear`}}") ✕
    else
      a.board-header-btn.js-open-filter-view(href="#", title="{{t $.L `filter`}}")
        i.fa.fa-filter
        span.board-header-btn-label {{t $.L "filter"}}
    a.board-header-btn.js-toggle-page-sidebar(href="#", title="{{t $.L `sidebar-open`}}", aria-label="{{t $.L `sidebar-open`}}") ☰
  //- WeKan's historyRecoveryNotice: a stopped Scrum History operation, and
    for a board admin its rollback or discard.
  if .HistoryCheckpoint
    .history-recovery-notice.history-checkpoint-notice.js-history-checkpoint-notice(role="status", aria-live="polite", data-board="{{.Board.ID}}", data-key="{{.HistoryCheckpoint.key}}", data-confirm="{{t $.L `scrum-history-checkpoint-discard-confirm`}}")
      p {{t $.L "scrum-history-checkpoint-stuck"}}
      if .HistoryCheckpoint.canResolve
        p.quiet.js-history-checkpoint-counts {{.HistoryCheckpoint.Counts}}
        p.quiet {{t $.L "scrum-history-checkpoint-hint"}}
        if .HistoryCheckpoint.canRollback
          button.primary.js-history-checkpoint-rollback(type="button") {{t $.L "scrum-history-checkpoint-rollback"}}
        button.js-history-checkpoint-discard(type="button") {{t $.L "scrum-history-checkpoint-discard"}}
      else
        p.quiet {{t $.L "scrum-history-checkpoint-ask-admin"}}
      p.warning.js-history-checkpoint-error(role="alert", hidden)
  .board-sidebar.sidebar
    a.sidebar-xmark.js-close-sidebar(href="#", aria-label="{{t $.L `close`}}") ✕
    .sidebar-content.js-board-sidebar-content
      if .Invited
        //- sidebar.jade: an invitation to this board, to accept or decline.
        .js-board-invitation
          p
            i.fa.fa-exclamation-triangle
            |  {{t $.L "just-invited"}}
          button.js-member-invite-accept.primary(type="button") {{t $.L "accept"}}
          button.js-member-invite-decline(type="button") {{t $.L "decline"}}
        hr
      //- WeKan's multiselectionSidebar: what to do with the selected cards.
      if .CanEdit
        .multiselection-sidebar.js-multiselection-view.is-hidden
          h3 {{t $.L "multi-selection-on"}}
          ul.pop-over-list
            li
              a.js-archive-selection(href="#") {{t $.L "archive-selection"}}
            if $.CanEdit
              li
                //- WeKan's multiselectionSidebar: the mixed selection's Move.
                a.sidebar-btn.js-move-selection(href="#")
                  i.fa.fa-upload
                  |  {{t $.L "move-selection"}}
          if $.CanEdit
            //- WeKan's moveObjectsPopup: where the selection goes - board,
              swimlane, list, card, checklist, item - and before or after it.
            template.js-pop-over-template(data-pop="move-objects", data-title="{{t $.L `move-selection`}}")
              .js-move-objects-form
                .warning.js-move-objects-error.is-hidden
                label {{t $.L "boards"}}
                select.js-object-destination(data-field="boardId")
                label {{t $.L "swimlanes"}}
                select.js-object-destination(data-field="swimlaneId", data-empty="—")
                label {{t $.L "lists"}}
                select.js-object-destination(data-field="listId", data-empty="—")
                label {{t $.L "cards"}}
                select.js-object-destination(data-field="cardId", data-empty="{{t $.L `add-card`}}")
                label {{t $.L "checklists"}}
                select.js-object-destination(data-field="checklistId", data-empty="{{t $.L `add-checklist`}}")
                label {{t $.L "r-item"}}
                select.js-object-destination(data-field="itemId", data-empty="—")
                select.js-object-position(aria-label="{{t $.L `move-selection`}}")
                  option(value="before") {{t $.L "move-selection-before"}}
                  option(value="after") {{t $.L "move-selection-after"}}
                button.primary.js-move-objects(type="button") {{t $.L "move-selection"}}
      //- WeKan's filterSidebar: its Advanced Filter, the board's cards by their
        custom fields and dates (advanced_filter.go). The board shows only the
        cards it matches; one that does not parse keeps the last that did.
      .filter-sidebar.js-filter-view.is-hidden(data-applied="{{.AppliedFilter}}")
        h3 {{t $.L "advanced-filter-label"}}
        input.js-field-advanced-filter(type="text", value="{{.AdvancedFilter}}")
        span {{t $.L "advanced-filter-description"}}
        p.quiet {{t $.L "advanced-filter-card-dates-hint"}}
      //- WeKan's archivesSidebar: the board's Archive, opened from Board Settings.
      .archives-sidebar.js-archives-view.is-hidden
        h3 {{t $.L "archives"}}
        if .Archived
          if $.CanEdit
            form.js-restore-all-form(method="post", action="/b/{{$.Board.ID}}/archive/restore-all-cards", up-submit, up-target=".board-wrapper")
              a.js-restore-all-cards(href="#") {{t $.L "restore-all"}}
          each it in .Archived
            if eq .Kind "cards"
              .minicard-wrapper.archived-item.archived-card-item(data-kind="{{.Kind}}", data-id="{{.ID}}")
                .minicard
                  .minicard-title {{.Title}}
                if $.CanEdit
                  form.js-restore-form(method="post", action="/b/{{$.Board.ID}}/archive/restore", up-submit, up-target=".board-wrapper")
                    input(type="hidden", name="kind", value="{{.Kind}}")
                    input(type="hidden", name="id", value="{{.ID}}")
                    if .Blocked
                      a.js-restore-card(href="#", data-pop="restore-card-{{.ID}}") {{t $.L "restore"}}
                    else
                      a.js-restore-card(href="#") {{t $.L "restore"}}
                  //- WeKan's restoreArchivedCardToListPopup (#6772): its list is
                  //- gone, or full at a hard WIP limit - choose one with room.
                  if .Blocked
                    if eq $.RestoreBlocked .ID
                      span.js-open-pop-on-load(data-pop="restore-card-{{.ID}}", hidden)
                    template.js-pop-over-template(data-pop="restore-card-{{.ID}}", data-title="{{t $.L `restore`}}")
                      .header
                        span.header-title {{t $.L "restore"}}
                        a.close-btn.js-close-pop-over(href="#", aria-label="{{t $.L `close`}}") ×
                      .content
                        p.js-restore-wip-reached {{.Blocked.Reason}}
                        if .Blocked.Targets
                          form(method="post", action="/b/{{$.Board.ID}}/archive/restore", up-submit, up-target=".board-wrapper")
                            input(type="hidden", name="kind", value="cards")
                            input(type="hidden", name="id", value="{{.ID}}")
                            select.js-select-restore-target-list(name="toList", autofocus)
                              each l in .Blocked.Targets
                                option(value="{{.ID}}") {{.Title}}
                            .edit-controls.clearfix
                              button.primary.confirm.js-restore-card-to-list(type="submit") {{t $.L "restore"}}
                        else
                          p.js-restore-no-list-with-room {{.Blocked.NoRoom}}
            else
              .archived-item(data-kind="{{.Kind}}", data-id="{{.ID}}")
                span.archived-item-title {{.Title}}
                if $.CanEdit
                  form.js-restore-form(method="post", action="/b/{{$.Board.ID}}/archive/restore", up-submit, up-target=".board-wrapper")
                    input(type="hidden", name="kind", value="{{.Kind}}")
                    input(type="hidden", name="id", value="{{.ID}}")
                    a.js-restore(href="#") {{t $.L "restore"}}
        else
          p.no-items-message {{t $.L "no-archived-cards"}}
      //- WeKan's membersWidget: the active members, and adding one.
      .board-widget.board-widget-members.membersWidget
        h3.board-widget-title {{t $.L "members"}}
        .board-widget-content
          each mem in .SidebarMembers
            a.member.js-member(href="#", data-user="{{.ID}}", title="{{.Fullname}} ({{.Username}})", aria-label="{{.Fullname}} ({{.Username}})")
              if .Avatar
                img.avatar.avatar-image(src="{{.Avatar}}", alt="{{.Username}}")
              else
                span.member-initials {{.Username}}
          if .CanInvite
            a.member.add-member.js-manage-board-members(href="#", title="{{t $.L `add-members`}}", aria-label="{{t $.L `add-members`}}")
              i.fa.fa-plus
      if .MenuOn
        h3
          a.board-header-btn.js-open-board-menu(href="#", title="{{t $.L `boardMenuPopup-title`}}") {{t $.L "boardMenuPopup-title"}}
      if .Board.AdminOf .User.ID
        hr
        h3.activity-title.js-toggle-show-activities(role="button", tabindex="0", title="{{t $.L `activities`}}")
          i.fa.fa-caret-right
          i.fa.fa-comment-o
          |  {{t $.L "activities"}}
        //- Shown on demand, as WeKan's: on the page once the list is opened.
        .activities.js-sidebar-activities.is-hidden
          template.js-stamp-on-open
            each act in .BoardActivities
              .activity(data-id="{{.ID}}")
                .activity-desc
                  span.activity-member {{.User}}
                  |  {{.Text}}
                time.activity-time(datetime="{{.ISO}}") {{.Display}}
  if .RestoreSkipped
    //- WeKan's restoreAllSkippedPopup: Restore all left these out (#6772).
    span.js-open-pop-on-load(data-pop="restore-all-skipped", hidden)
    template.js-pop-over-template(data-pop="restore-all-skipped", data-title="{{t $.L `restore-all`}}")
      .header
        span.header-title {{t $.L "restore-all"}}
        a.close-btn.js-close-pop-over(href="#", aria-label="{{t $.L `close`}}") ×
      .content
        p.js-restore-all-skipped {{.RestoreSkipped}}
  | {{template "_boardviews" .}}
  template.js-pop-over-template(data-pop="board-menu", data-title="{{t $.L `boardMenuPopup-title`}}")
    .header
      span.header-title {{t $.L "boardMenuPopup-title"}}
      a.close-btn.js-close-pop-over(href="#", aria-label="{{t $.L `close`}}") ×
    .content
      ul.pop-over-list
        li
          a.js-open-archives(href="#")
            i.fa.fa-archive
            |  {{t $.L "archived-items"}}
        li
          a.js-open-history(href="/b/{{.Board.ID}}/history")
            i.fa.fa-history
            |  {{t $.L "history"}}
        if .CanExport
          li
            a.js-export-board(href="#") {{t $.L "export"}}
        li
          a.js-open-board-card-settings(href="#", data-pop="board-card-settings")
            i.fa.fa-id-card-o
            |  {{t $.L "card-settings"}}
        if .Board.AdminOf .User.ID
          li
            a.js-open-rules-view(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules", title="{{t $.L `rules`}}")
              i.fa.fa-magic
              |  {{t $.L "rules"}}
          li
            a.js-open-rules-list-view(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules?view=list", title="{{t $.L `r-list-view`}}")
              i.fa.fa-list
              |  {{t $.L "r-list-view"}}
          li
            a.js-open-rules-workflow-view(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules?view=workflow", title="{{t $.L `r-workflow-view`}}")
              i.fa.fa-sitemap
              |  {{t $.L "r-workflow-view"}}
          li
            a.js-open-rules-import-export(href="/b/{{.Board.ID}}/{{.Board.Slug}}/rules?view=import", title="{{t $.L `rulesImportExportPopup-title`}}")
              i.fa.fa-exchange
              |  {{t $.L "rulesImportExportPopup-title"}}
          li
            a.js-open-board-notifications(href="/b/{{.Board.ID}}/{{.Board.Slug}}/notifications", title="{{t $.L `notifications`}}")
              i.fa.fa-bell
              |  {{t $.L "notifications"}}
  //- WeKan's boardCardSettingsPopup (sidebar.jade): Board Settings / Card,
    both sides at once - the Minicard pane, then the Card pane - each the
    board's sections as checklists. A section's checkbox shows or hides the
    whole section on that side; a row's is the board's setting for that side
    (card_settings.go). A board admin's, but for the user's own labels text.
  template.js-pop-over-template(data-pop="board-card-settings", data-popup="boardCardSettingsPopup", data-title="{{t $.L `card-settings`}}")
    .header
      span.header-title {{t $.L "card-settings"}}
      a.close-btn.js-close-pop-over(href="#", aria-label="{{t $.L `close`}}") ×
    .content.card-settings-panes-container
      .card-settings-panes
        each p in .CardSettings
          .card-settings-inline.card-settings-pane.js-card-settings-inline.js-card-settings-pane(data-side="{{.Side}}", data-board="{{$.Board.ID}}", data-revision="{{.ScrumRevision}}", class="card-settings-pane-{{.Side}}")
            .card-settings-pane-head
              h3.card-settings-pane-title {{.Title}}
            .card-settings-pane-body
              .card-settings-inline-sections.js-card-settings-sections-sortable(data-side="{{.Side}}")
                each sec in .Sections
                  .card-settings-inline-section.js-card-settings-section(data-section="{{.ID}}", class="{{if not .Shown}}is-section-hidden{{end}}")
                    .card-settings-inline-section-head
                      a.card-settings-inline-collapse.js-toggle-card-settings-section(href="#", role="button", aria-expanded="true", title="{{t $.L `collapse`}}", aria-label="{{t $.L `collapse`}}")
                        i.fa.fa-caret-down(aria-hidden="true")
                      span.card-settings-side.card-settings-section-side
                        a.flex.card-field-order-toggle.card-settings-section-toggle(href="#", class="{{if .Writable}}js-card-settings-section-shown{{else}}is-disabled{{end}} {{if .Shown}}is-checked{{end}}", role="checkbox", aria-checked="{{if .Shown}}true{{else}}false{{end}}", aria-label="{{.Title}}")
                          .materialCheckBox(class="{{if .Shown}}is-checked{{end}}")
                      h4.card-settings-inline-section-title(class="{{if .Writable}}js-card-settings-section-handle{{end}}")
                        i.fa(class="{{.Icon}}", aria-hidden="true")
                        |  {{.Title}}
                      span.card-settings-inline-section-count {{.CheckedCount}}/{{len .Lines}}
                    .card-settings-inline-items
                      each line in .Lines
                        .card-settings-line.card-settings-inline-item.js-card-field-order-row(data-key="{{.Key}}", data-side="{{.Side}}", data-kind="{{.Kind}}", data-field="{{.Field}}", data-scrum="{{.Scrum}}")
                          span.card-settings-side(class="card-settings-side-{{.Side}}")
                            a.flex.card-field-order-toggle(href="#", class="{{if .Writable}}js-card-settings-toggle{{else}}is-disabled{{end}} {{if .Checked}}is-checked{{end}}", role="checkbox", aria-checked="{{if .Checked}}true{{else}}false{{end}}", aria-label="{{.Title}}")
                              .materialCheckBox(class="{{if .Checked}}is-checked{{end}}")
                          span.card-settings-line-label(class="{{if .Writable}}js-card-field-order-handle{{end}}")
                            each icon in .Icons
                              i.fa(class="{{.}}", aria-hidden="true")
                            | {{.Title}}
  if .CanEdit
    //- WeKan's swimlaneAddPopup: a swimlane below or above the chosen one.
    template.js-pop-over-template(data-pop="add-swimlane", data-title="{{t $.L `swimlaneAddPopup-title`}}")
      form.js-add-swimlane-form(method="post", action="/b/{{.Board.ID}}/swimlanes", up-submit, up-target=".board-wrapper")
        input.js-swimlane-after(type="hidden", name="after")
        textarea.swimlane-name-input.full-line(name="title", rows="2", dir="auto", placeholder="{{t $.L `add-swimlane`}}", aria-label="{{t $.L `add-swimlane`}}", autocomplete="off", required)
        label.swimlane-placement-option
          input.js-swimlane-placement(type="radio", name="placement", value="below", checked)
          span(dir="auto") {{t $.L "below-selected-swimlane"}}
        label.swimlane-placement-option
          input.js-swimlane-placement(type="radio", name="placement", value="above")
          span(dir="auto") {{t $.L "above-selected-swimlane"}}
        .edit-controls.clearfix
          button.primary.confirm(type="submit") {{t $.L "add"}}
  //- WeKan's memberPopup and removeMemberPopup, for each member.
  each mem in .SidebarMembers
    template.js-pop-over-template(data-pop="member-{{.ID}}", data-title="{{.Fullname}}")
      .board-member-menu
        .miniprofile-header
          .info
            h3
              .js-profile {{.Fullname}}
            p.quiet @{{.Username}}
        ul.pop-over-list
          if and $.IsBoardAdmin (not .Self)
            li
              a.js-remove-member(href="#", data-user="{{.ID}}") {{t $.L "remove-from-board"}}
    if $.IsBoardAdmin
      template.js-pop-over-template(data-pop="remove-member-{{.ID}}", data-title="{{t $.L `remove-member`}}")
        form(method="post", action="/b/{{$.Board.ID}}/members/{{.ID}}/remove", up-submit, up-target=".board-wrapper")
          p {{t $.L "remove-member"}}: {{.Fullname}} (@{{.Username}})
          button.js-confirm.negate.full(type="submit") {{t $.L "remove-member"}}
  if .CanInvite
    //- WeKan's addMemberPopup: search, then pick.
    template.js-pop-over-template(data-pop="add-member", data-title="{{t $.L `add-members`}}")
      .js-search-member
        input.js-search-member-input(type="text", placeholder="{{t $.L `email-address`}}", aria-label="{{t $.L `add-members`}}")
      ul.pop-over-list.js-member-search-results
  if .Card
    if .CanEdit
      //- WeKan's cardLabelsPopup: each label of the board, on the card or off.
      template.js-pop-over-template(data-pop="card-labels", data-title="{{t $.L `cardLabelsPopup-title`}}")
        ul.edit-labels-pop-over
          each lb in .CardLabels
            li.js-card-label-item
              form(method="post", action="/b/{{$.Board.ID}}/cards/{{$.Card.ID}}/labels/{{.ID}}", up-submit, up-target=".board-wrapper")
                button.card-label.card-label-selectable.js-select-label(type="submit", class="card-label-{{.Color}}{{if .Selected}} active{{end}}") {{.Name}}{{if .Selected}} ✓{{end}}
        if .IsBoardAdmin
          a.quiet-button.full.js-add-label(href="#") {{t $.L "createLabelPopup-title"}}
      //- WeKan's createLabelPopup: a name and a color.
      template.js-pop-over-template(data-pop="create-label", data-title="{{t $.L `createLabelPopup-title`}}")
        form.create-label(method="post", action="/b/{{.Board.ID}}/labels", up-submit, up-target=".board-wrapper")
          input(type="hidden", name="card", value="{{.Card.ID}}")
          label(for="labelName") {{t $.L "name"}}
          textarea.js-label-name#labelName(rows="2", name="name")
          label {{t $.L "select-color"}}
          .palette-colors
            each col in .LabelPalette
              label.card-label.palette-color.js-palette-color(class="card-label-{{.}}", title="{{.}}")
                input(type="radio", name="color", value="{{.}}")
          button.primary.wide(type="submit") {{t $.L "create"}}
      template.js-pop-over-template(data-pop="move-card", data-title="{{t $.L `moveCardPopup-title`}}")
        form.js-card-target(method="post", action="/b/{{.Board.ID}}/cards/{{.Card.ID}}/move-to", up-submit, up-target=".board-wrapper", up-history="true")
          label {{t $.L "boards"}}
          select.js-select-boards(name="boardId")
            each tb in .TargetBoards
              option(value="{{.ID}}") {{.Title}}
          label {{t $.L "swimlane"}}
          select.js-select-swimlanes(name="swimlaneId")
            each sw in .Swimlanes
              option(value="{{.ID}}") {{.N}}. {{.Title}}
          label {{t $.L "list"}}
          select.js-select-lists(name="listId")
            each li in .Lists
              option(value="{{.ID}}") {{.N}}. {{.Title}}
          button.primary.confirm.js-done(type="submit") {{t $.L "done"}}
      template.js-pop-over-template(data-pop="copy-card", data-title="{{t $.L `copyCardPopup-title`}}")
        form.js-card-target(method="post", action="/b/{{.Board.ID}}/cards/{{.Card.ID}}/copy-to", up-submit, up-target=".board-wrapper")
          label(for="copy-card-title") {{t $.L "title"}}
          textarea#copy-card-title(name="title", rows="2") {{.Card.Title}}
          label {{t $.L "boards"}}
          select.js-select-boards(name="boardId")
            each tb in .TargetBoards
              option(value="{{.ID}}") {{.Title}}
          label {{t $.L "swimlane"}}
          select.js-select-swimlanes(name="swimlaneId")
            each sw in .Swimlanes
              option(value="{{.ID}}") {{.N}}. {{.Title}}
          label {{t $.L "list"}}
          select.js-select-lists(name="listId")
            each li in .Lists
              option(value="{{.ID}}") {{.N}}. {{.Title}}
          button.primary.confirm.js-done(type="submit") {{t $.L "done"}}
      //- WeKan's checklistActionsPopup: its Export / Import first - reading,
        so above the rows that change the checklist.
      template.js-pop-over-template(data-pop="checklist-actions", data-title="{{t $.L `checklistActionsPopup-title`}}")
        .header
          span.header-title {{t $.L "checklistActionsPopup-title"}}
          a.close-btn.js-close-pop-over(href="#", aria-label="{{t $.L `close`}}") ×
        .content
          ul.pop-over-list
            li
              a.js-export-checklist(href="#")
                i.fa.fa-exchange
                |  {{t $.L "export"}} / {{t $.L "import"}} ...
          hr
          ul.pop-over-list
            li
              a.js-delete-checklist.delete-checklist(href="#")
                i.fa.fa-trash
                |  {{t $.L "delete"}} ...
              a.js-move-checklist.move-checklist(href="#")
                i.fa.fa-arrow-right
                |  {{t $.L "moveChecklist"}} ...
              a.js-copy-checklist.copy-checklist(href="#")
                i.fa.fa-copy
                |  {{t $.L "copyChecklist"}} ...
      //- WeKan's moveChecklistPopup and copyChecklistPopup (copyAndMoveChecklist):
        a board, swimlane, list and card the user may change; static/weddy.js
