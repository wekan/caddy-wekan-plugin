.setting-content.profile
  h1 {{t $.L "edit-profile"}}
  if .Saved
    p.cloud-saved.js-profile-saved {{t $.L "cloud-saved"}}
  if .Error
    p.at-error.js-profile-error {{.ErrorText}}
  form.js-profile-form(method="post", action="/profile")
    label(for="profile-fullname") {{t $.L "fullname"}}
    input#profile-fullname(type="text", name="fullname", value="{{.User.Profile.Fullname}}")
    label(for="profile-initials") {{t $.L "initials"}}
    input#profile-initials(type="text", name="initials", value="{{.User.Profile.Initials}}", maxlength="8")
    button.primary(type="submit") {{t $.L "save"}}
  //- WeKan's changeAvatarPopup: upload a picture, or go back to the initials.
  h2 {{t $.L "change-avatar"}}
  if .User.Profile.AvatarURL
    img.avatar.avatar-image.js-profile-avatar(src="{{avatarURL .User.Profile.AvatarURL}}", alt="{{.User.Username}}")
  form.js-avatar-form(method="post", action="/profile/avatar", enctype="multipart/form-data")
    label(for="profile-avatar") {{t $.L "upload-avatar"}}
    input#profile-avatar.js-upload-avatar-input(type="file", name="avatar", accept="image/*", required)
    button.primary(type="submit") {{t $.L "upload-avatar"}}
  if .User.Profile.AvatarURL
    form.js-avatar-remove(method="post", action="/profile/avatar/remove")
      button(type="submit") {{t $.L "initials"}}
  h2 {{t $.L "changePasswordPopup-title"}}
  form.js-password-form(method="post", action="/profile/password")
    label(for="old-password") {{t $.L "password"}}
    input#old-password(type="password", name="oldPassword", autocomplete="current-password", required)
    label(for="new-password") {{t $.L "change-password"}}
    input#new-password(type="password", name="newPassword", autocomplete="new-password", minlength="8", required)
    label(for="new-password2") {{t $.L "password-again"}}
    input#new-password2(type="password", name="newPassword2", autocomplete="new-password", minlength="8", required)
    button.primary(type="submit") {{t $.L "change-password"}}
  //- WeKan's Member Settings / Notification Settings, the member's own part
    of #3695 / #5171: how their e-mail and tray deliver ("Default" is the
    board's, else Admin Panel's), and leaving their name out of webhooks.
  h2#notification-settings {{t $.L "notifications"}}
  each d in .Delivery
    form.js-member-delivery(method="post", action="/profile/notifications", data-channel="{{.Channel}}")
      input(type="hidden", name="channel", value="{{.Channel}}")
      input.js-browser-timezone(type="hidden", name="browserTimezone", value="")
      h3 {{.Title}}
      label(for="delivery-{{.Channel}}-layout") {{t $.L "notification-delivery-layout"}}
      select.js-delivery-layout(id="delivery-{{.Channel}}-layout", name="layout")
        each o in .Layouts
          if .Selected
            option(value="{{.Value}}", selected) {{.Label}}
          else
            option(value="{{.Value}}") {{.Label}}
      p {{t $.L "notification-delivery-parts"}}
      label.notification-delivery-default
        if .PartsDefault
          input.js-delivery-parts-default(type="checkbox", name="partsDefault", value="true", checked)
        else
          input.js-delivery-parts-default(type="checkbox", name="partsDefault", value="true")
        | {{t $.L "default"}}
      each o in .Parts
        label.notification-delivery-part
          if .Selected
            input.js-delivery-part(type="checkbox", name="parts", value="{{.Value}}", checked)
          else
            input.js-delivery-part(type="checkbox", name="parts", value="{{.Value}}")
          | {{.Label}}
      label(for="delivery-{{.Channel}}-grouping") {{t $.L "notification-delivery-grouping"}}
      select.js-delivery-grouping(id="delivery-{{.Channel}}-grouping", name="grouping")
        each o in .Groupings
          if .Selected
            option(value="{{.Value}}", selected) {{.Label}}
          else
            option(value="{{.Value}}") {{.Label}}
      label(for="delivery-{{.Channel}}-schedule") {{t $.L "notification-delivery-schedule"}}
      select.js-delivery-schedule(id="delivery-{{.Channel}}-schedule", name="schedule")
        each o in .Schedules
          if .Selected
            option(value="{{.Value}}", selected) {{.Label}}
          else
            option(value="{{.Value}}") {{.Label}}
      label(for="delivery-{{.Channel}}-interval") {{t $.L "notification-delivery-interval"}}
      select.js-delivery-interval(id="delivery-{{.Channel}}-interval", name="intervalMinutes")
        each o in .Intervals
          if .Selected
            option(value="{{.Value}}", selected) {{.Label}}
          else
            option(value="{{.Value}}") {{.Label}}
      label(for="delivery-{{.Channel}}-daily") {{t $.L "notification-delivery-daily-time"}}
      input.js-delivery-daily(id="delivery-{{.Channel}}-daily", type="time", name="dailyTime", value="{{.DailyTime}}")
      p {{t $.L "notification-delivery-quiet"}}
      label
        | {{t $.L "notification-delivery-quiet-from"}}
        input.js-delivery-quiet-start(type="time", name="quietStart", value="{{.QuietStart}}")
      label
        | {{t $.L "notification-delivery-quiet-to"}}
        input.js-delivery-quiet-end(type="time", name="quietEnd", value="{{.QuietEnd}}")
      if .Timezone
        p.quiet.js-delivery-timezone {{t $.L "notification-delivery-timezone"}} {{.Timezone}}
        input(type="hidden", name="timezone", value="{{.Timezone}}")
      button.primary.js-delivery-save(type="submit") {{t $.L "save"}}
  form.js-member-webhook(method="post", action="/profile/notifications")
    input(type="hidden", name="channel", value="webhook")
    h3 {{t $.L "outgoing-webhooks"}}
    label.js-webhook-hide-identity
      if .HideIdentity
        input(type="checkbox", name="hideIdentity", value="true", checked)
      else
        input(type="checkbox", name="hideIdentity", value="true")
      | {{t $.L "webhook-hide-identity"}}
    button.primary.js-webhook-hide-save(type="submit") {{t $.L "save"}}
