  "unsupported": [
    {
      "path": "/dates",
      "reason": "Planner dates mix day/month and month/day order; read as month/day"
    },
    {
      "path": "/row/5/Completed Checklist Items",
      "reason": "Planner exports how many checklist items are done (1/3), not which; all are imported as not done"
    },
    {
      "path": "/row/5/Is Recurring",
      "reason": "a recurring Planner task is imported once; its repeat has no place in the export"
    },
    {
      "path": "/row/5/Start Date",
      "reason": "Planner date \"13.10.2026\" is not a calendar date"
    },
    {
      "path": "/row/6/Progress",
      "reason": "Planner progress \"Done?\" is not one of Not started, In progress, Completed"
    },
    {
      "path": "/row/6/Priority",
      "reason": "Planner priority \"Whatever\" is not one of Urgent, Important, Medium, Low"
    },
    {
      "path": "/row/6/Created Date",
      "reason": "Planner date \"2/30/2026\" is not a calendar date"
    },
    {
      "path": "/row/8",
      "reason": "a Planner row without a task name is not imported"
    },
    {
      "path": "/row/9/Due Date",
