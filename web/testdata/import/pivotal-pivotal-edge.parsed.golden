  "warnings": [],
  "unsupported": [
    {
      "path": "/columns/mystery",
      "reason": "Pivotal Tracker does not write a \"mystery\" column; it is not imported"
    },
    {
      "path": "/row/2/Comment/2",
      "reason": "a Pivotal Tracker comment without \"(Author - Mon D, YYYY)\" is imported without its author and date"
    },
    {
      "path": "/row/2/Blocker/2",
      "reason": "a Pivotal Tracker blocker that names no single story (#id) is not imported"
    },
    {
      "path": "/row/2/pull request",
      "reason": "1 Pivotal Tracker pull request(s) of this story are not imported"
    },
    {
      "path": "/row/2/git branch",
      "reason": "1 Pivotal Tracker git branch(s) of this story are not imported"
    },
    {
      "path": "/row/2/deadline",
      "reason": "Pivotal Tracker date \"Feb 30, 2026\" is not \"Mon D, YYYY\" or \"MM/DD/YYYY\""
    },
    {
      "path": "/row/3/Current State",
      "reason": "Pivotal Tracker state \"weird\" is not one of unscheduled, unstarted, planned, started, finished, delivered, accepted, rejected; imported as unstarted"
    },
    {
      "path": "/row/3/Blocker/1",
      "reason": "a resolved Pivotal Tracker blocker is not imported"
    },
    {
      "path": "/row/3/created at",
      "reason": "Pivotal Tracker date \"13/45/2026\" is not \"Mon D, YYYY\" or \"MM/DD/YYYY\""
    },
    {
      "path": "/row/3/accepted at",
      "reason": "Pivotal Tracker date \"Smarch 1 2026\" is not \"Mon D, YYYY\" or \"MM/DD/YYYY\""
    },
    {
      "path": "/row/4/Type",
      "reason": "Pivotal Tracker type \"story\" is not one of feature, bug, chore, epic, release; imported as feature"
    },
    {
      "path": "/row/4/Estimate",
      "reason": "Pivotal Tracker estimate \"abc\" is not a number of points"
    },
    {
      "path": "/row/4/Priority",
      "reason": "Pivotal Tracker priority \"P9 - Bad\" is not p0 to p3"
    },
    {
      "path": "/row/5/Comment/1",
      "reason": "a Pivotal Tracker comment without \"(Author - Mon D, YYYY)\" is imported without its author and date"
    }
  ],
  "scrumTransfer": {
    "format": "wekan-scrum-2",
    "settings": {
